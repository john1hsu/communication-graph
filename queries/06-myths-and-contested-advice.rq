# title: Myths and contested advice
# question: Which pieces of communication advice are contested, mixed or failed to replicate, and what challenges them?
# gap: false
SELECT ?node ?status ?challenger WHERE {
  ?node cmo:evidenceStatus ?status .
  FILTER(?status IN ("contested", "failed-replication", "mixed"))
  OPTIONAL { ?node cmo:challengedBy ?challenger }
} ORDER BY ?status ?node
