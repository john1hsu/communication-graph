  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Which terms, acronyms or steps in this message did I learn on the job rather than expect my reader to know?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "If my reader had only this message and none of my background, what would they do next?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Have I asked someone outside the work to restate my point in their own words, or am I only judging clarity myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Who exactly is reading this, and what do they already know about the subject?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Which terms here did I learn inside my team or field, and have I replaced or defined each one where it first appears?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Could a reader say in their own words what I want them to do next?"
  },
