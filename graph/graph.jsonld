  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "Who will read or hear this - including people copied or forwarded to - and which of them is the one who must act?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "What does my primary audience already know, and which of my terms or steps would they not recognise?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "What is in this for them, and do they see it in the first few lines?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "Have I checked my picture of the audience against something they actually said or did, or am I only guessing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Subject: Data migration finishing three weeks later than planned (no change to cost). The move to the new reporting system will finish on 4 December instead of 13 November. Your month-end reports will run on the old system as usual until then. Technical details for your IT team are in the section below.",
   "cmo:before": "Heads up - the ETL refactor slipped because the CDC connector kept OOMing on the backfill. New ETA is sprint 14, assuming infra gets us the bigger nodes.",
   "cmo:situation": "An engineering lead emails a delay notice about a data-platform migration to a list that includes the client's finance director.",
   "cmo:why": "The finance director is the primary reader and needs the date, the impact on her work and the cost; the jargon and team shorthand move to a separate section for the technical secondary audience."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto",
   "@type": "schema:HowTo",
   "schema:name": "Audience analysis",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "List every audience, not just the addressee - the decision maker, technical reviewers, people who are copied, people the message may be forwarded to and people affected by the outcome."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "For the primary audience, write down what they already know, what they care about, what attitude they are likely to bring and what they must decide or do after reading."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Check your assumptions against evidence - the questions people actually ask you, past replies, usage data or a short conversation with a typical reader."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Choose content, order, vocabulary, tone and channel to fit the primary audience, putting what matters to them first."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Give secondary audiences their own clearly labelled section instead of mixing material for different readers."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Reread the draft as each audience in turn - including someone it might be forwarded to - and fix what would confuse or alienate them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "If my reader read only the subject line and first two sentences, would they know what I need from them and by when?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "Have I stated my conclusion or recommendation, or only described the situation and left the reader to infer it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "Is this message an exception - serious bad news, or a reader who expects context first - and have I chosen the structure on purpose?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Subject: Decision needed by Thursday - switch reporting vendor for Q1. Sam, I recommend we move the Q1 reports to our backup vendor; it adds about two weeks of setup but keeps the March board deadline. Please approve or decline by Thursday. Background: our current vendor's new platform cannot produce the quarterly export (confirmed on Tuesday's call), and deliveries have been late twice since September.",
   "cmo:before": "Hi Sam, I wanted to give you some background on the reporting vendor. Over the last two months we have seen several late deliveries, and after a call with their account team on Tuesday it looks like their new platform will not support our quarterly export. I have looked at a few options...",
   "cmo:situation": "A project analyst emails her director about a vendor problem that needs a decision.",
   "cmo:why": "The recommendation, the decision asked for and the deadline appear in the subject line and first two sentences, so the director can act without reading the history, which is still there for anyone who wants it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto",
   "@type": "schema:HowTo",
   "schema:name": "Bottom line up front",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before drafting, write one sentence that states your conclusion, recommendation or request, including any decision and deadline you need."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Make that sentence (after a short purpose statement if the format calls for one) the opening of the message, and echo it in the subject line or title."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Add only the background the reader needs to act on it, most important first, and move history and method to the end or an attachment."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Put any secondary requests or audiences in clearly labelled sections below the main point."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Reread only the first two lines and ask whether a busy reader could act on them alone; if not, rewrite them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Decide deliberately whether this message is an exception - serious bad news or a reader who expects context first - and if so use an indirect structure on purpose rather than by habit."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Which terms, acronyms or steps in this message did I learn on the job rather than expect my reader to know?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "If my reader had only this message and none of my background, what would they do next?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Have I asked someone outside the work to restate my point in their own words, or am I only judging clarity myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Who exactly is reading this, and what do they already know about the subject?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Which terms here did I learn inside my team or field, and have I replaced or defined each one where it first appears?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Could a reader say in their own words what I want them to do next?"
  },
