    "@id": "cm:employee-engagement"
   },
   "dcterms:created": {
    "@type": "xsd:date",
    "@value": "2026-11-05"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/zoom-fatigue/s6"
    }
   ],
   "rdfs:label": "Zoom fatigue",
   "skos:altLabel": [
    "video call fatigue",
    "videoconference fatigue",
    "videoconferencing fatigue"
   ],
   "skos:broader": [
    {
     "@id": "cm:video-call-communication"
    },
    {
     "@id": "cm:workplace-meetings"
    }
   ],
   "skos:definition": "The tiredness and depletion people report after video meetings, linked to sustained close-up eye contact, the extra effort of sending and reading nonverbal cues on screen, watching a self-view and being kept still in front of a camera; it drains the energy people bring to later meetings and makes them less likely to speak up.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/communication-graph/id/scheme/digital-and-async-communication"
   },
   "skos:prefLabel": "Zoom fatigue",
   "skos:related": [
    {
     "@id": "cm:asynchronous-communication"
    },
    {
     "@id": "cm:channel-selection"
    },
    {
     "@id": "cm:information-overload"
    },
    {
     "@id": "cm:media-richness-theory"
    },
    {
     "@id": "cm:proxemics"
    },
    {
     "@id": "cm:spotlight-effect"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:1-2-4-all"
   },
   "rdfs:label": "Was my invitation specific enough that someone could write concrete answers to it in one minute?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:1-2-4-all"
   },
   "rdfs:label": "Did I protect the silent reflection, or did someone (including me) start talking before everyone had written?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:1-2-4-all"
   },
   "rdfs:label": "In the all-group share, did I ask for new ideas from each group rather than letting the most confident group report everything?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:1-2-4-all"
   },
   "rdfs:label": "Did I steer the content of the small-group conversations, or did I limit myself to running time and process?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Take one minute on your own and jot down every change you think would cut late-night incidents. Now share with the person next to you for two minutes, then join another pair for five. Each group of four, give me the one idea we haven't heard yet.",
   "cmo:before": "So, what should we change to cut down on incidents? ... Good point, Priya [senior engineer], more alerting makes sense. Anyone else? No? Let's take that as the action.",
   "cmo:situation": "A team lead runs a 30-minute retrospective with ten engineers, two of whom are senior and usually speak first, to find ways to reduce late-night production incidents.",
   "cmo:why": "The open question lets the first senior voice set the answer and the quiet engineers never speak; reflecting alone and then in pairs means everyone has an idea and a low-risk audience before the whole room hears anything, so more and more varied options surface."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto",
   "@type": "schema:HowTo",
   "schema:name": "1-2-4-All",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Write one open, specific invitation the group can act on, such as \"What opportunities do you see to cut our release lead time?\", and show it to everyone."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Give one minute of silent, individual reflection in which each person writes their own ideas; protect the silence and do not talk over it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Have people pair up for two minutes to share and build on each other's ideas, keeping different ideas distinct rather than forcing agreement."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Merge pairs into groups of four for about five minutes to compare ideas and pick out the ones that stand out."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Bring everyone back and ask each group for one important idea that is not yet on the board, recording each one, until the strongest ideas are visible."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/1-2-4-all/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Close by naming what the group will do with the ideas - prioritise them, assign owners or feed them into a decision - and debrief briefly with a co-host on how the process went."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-listening/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-listening"
   },
   "rdfs:label": "Could I state their point, and how they feel about it, well enough that they would say \"yes, exactly\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-listening/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-listening"
   },
   "rdfs:label": "Did I hold back advice, reassurance and my own counter-argument until they confirmed I understood?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-listening/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-listening"
   },
   "rdfs:label": "Was my attention on them, or was I rehearsing my reply or glancing at a screen?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-listening/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-listening"
   },
   "rdfs:label": "Did I ask at least one question that drew out something they had not yet said?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-listening/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-listening"
   },
   "rdfs:label": "Would they leave this conversation feeling heard, even if I did not agree with them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-voice"
   },
   "rdfs:label": "Can the reader tell, sentence by sentence, who is responsible for each action?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-voice"
   },
   "rdfs:label": "Where I kept a passive, is the actor unknown, unimportant or obvious, or am I hiding who decided?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:active-voice"
   },
   "rdfs:label": "Did I mislabel any sentence as passive just because it uses \"was\" or describes the past?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Our QA lead will review the test results by Tuesday. Your team needs to fix any open issues by Thursday, and then I will approve the release.",
   "cmo:before": "The test results will be reviewed and any outstanding issues must be resolved before the release can be approved.",
   "cmo:situation": "A project manager tells a client team what happens before go-live.",
   "cmo:why": "The original names no one, so each side can assume the other owns the work; the rewrite assigns every action to a person and a date."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto",
   "@type": "schema:HowTo",
   "schema:name": "Active voice",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/5"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Find each sentence that has a form of \"to be\" plus a past participle (was sent, will be reviewed, has been approved)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Ask who does the action; if the sentence does not say, decide who should, and name them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Rewrite with that actor as the subject and a strong verb right after it (\"Finance will review the budget\")."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Address the reader as \"you\" when they are the one who must act."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/active-voice/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Keep a passive only when the actor is unknown, unimportant or obvious, or when the thing acted on is what the paragraph is about."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:anxiety-reappraisal"
   },
   "rdfs:label": "Am I trying to force myself to feel calm, or accepting that being keyed up is normal before something that matters?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:anxiety-reappraisal"
   },
   "rdfs:label": "What is one thing that could go well in this talk, and have I pointed my energy at it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:anxiety-reappraisal"
   },
   "rdfs:label": "Am I using the reframe as a substitute for preparing and rehearsing out loud?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:anxiety-reappraisal"
   },
   "rdfs:label": "After the talk, am I judging it by what the audience did, or by how nervous I felt?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "My heart's racing because this matters - that's energy I can use. I'm excited to show them why the logistics overspend is a one-off and get the forecast approved.",
   "cmo:before": "Calm down, calm down. They'll see I'm nervous. Just get through the slides without messing up.",
   "cmo:situation": "A finance analyst is about to present a quarterly variance review to the leadership team for the first time and notices her hands shaking in the corridor.",
   "cmo:why": "The first version fights the arousal, which rarely works, and keeps attention on what could go wrong. The second accepts the arousal, labels it as excitement and points it at a concrete opportunity - the shift the reappraisal studies tested."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto",
   "@type": "schema:HowTo",
   "schema:name": "Anxiety reappraisal",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Expect your heart rate, breathing and alertness to rise before the talk, and stop treating that as proof that something is wrong."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Remind yourself, in a sentence, what the arousal is for - it moves oxygen and attention to where you need them for the task."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Just before you start, say \"I am excited\" (aloud or under your breath) instead of telling yourself to calm down."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Turn the excitement toward the opportunity - name one thing that could go well, such as the decision you want the audience to make."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Pair the reframe with preparation and rehearsal; it changes how the nerves feel, not whether you know your material."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/anxiety-reappraisal/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Afterwards, judge the talk by what the audience understood or decided, not by how anxious you felt."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:apology"
   },
   "rdfs:label": "Have I said exactly what I did, in the first person, without \"if\", \"but\" or a passive construction?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:apology"
   },
   "rdfs:label": "Does my apology show that I understand what this cost the other person, not just how bad I feel?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:apology"
   },
   "rdfs:label": "Is my explanation short enough that it cannot be read as an excuse?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:apology"
   },
   "rdfs:label": "Have I offered a concrete repair and a change with a date, and will I actually follow through?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:apology"
   },
   "rdfs:label": "Is this a lapse of skill, where apologizing helps, or an accusation about my honesty that I believe is false, where admitting it could backfire?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Priya, I sent you last month's cost model instead of the final one, and that's on me - it meant you presented figures to your leadership that were about 8% too low. The correct file is attached with the changes highlighted, and I can join a 15-minute call with your CFO tomorrow to walk through the difference. From now on every client file will go out only from the release folder after a second-person check, starting today.",
   "cmo:before": "Hi Priya, apologies for any confusion around the model - there were a few version-control issues on our side this week. Hope you can forgive the mix-up! Updated file attached.",
   "cmo:situation": "A project analyst sent a client the wrong version of a cost model, and the client's finance director presented outdated numbers to her own leadership team.",
   "cmo:why": "The rewrite names the specific error, takes responsibility in the first person and acknowledges the client's cost, then offers an immediate repair and a preventive change - the two components rated most effective - and drops the request for forgiveness, rated least effective."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto",
   "@type": "schema:HowTo",
   "schema:name": "Apology",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Apologize as soon as you know you caused the problem; do not wait until legal, political or face-saving worries have shaped the message."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Name the specific thing you did and say plainly that it was your responsibility, without \"if anyone was offended\" or a passive \"mistakes were made\"."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "State the concrete effect on the other person (lost time, rework, an embarrassing moment with their client) so they can see you understand the cost to them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Give a short explanation of what went wrong only if it helps them trust the fix, and stop before it turns into an excuse."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Offer a specific repair for this instance and a change that prevents a repeat, with an owner and a date."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/apology/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Leave out the demand for forgiveness; then listen to their reaction and follow through visibly on what you promised."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:assertion-evidence-slides"
   },
   "rdfs:label": "If someone read only my slide headlines, would they get my argument and my conclusion?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:assertion-evidence-slides"
   },
   "rdfs:label": "Does each slide make exactly one point, and does the visual actually prove that point rather than decorate it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:assertion-evidence-slides"
   },
   "rdfs:label": "Am I planning to explain each visual, or am I going to read the headline and bullets aloud?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:assertion-evidence-slides"
   },
   "rdfs:label": "Is the material complex enough to need visual evidence, or would a simple spoken point serve the audience better?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Headline: 'Late deliveries doubled after July because Warehouse B lost its night shift'. Body: a line chart of weekly on-time rate for each warehouse, with Warehouse B's drop marked at the week the night shift ended.",
   "cmo:before": "Headline: 'Q3 delivery performance'. Bullets: 'On-time rate down', 'Carrier changes in July', 'Warehouse B staffing', 'Weather events', 'Next steps'.",
   "cmo:situation": "An operations analyst is presenting the cause of a rise in late deliveries to the regional leadership team.",
   "cmo:why": "The first slide names a topic and leaves the audience to work out which bullet matters. The second states the conclusion in the headline and shows the one chart that proves it, so leaders who only glance at the slide still take away the cause."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto",
   "@type": "schema:HowTo",
   "schema:name": "Assertion-evidence slides",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before opening the slide software, write the talk's main message, then list the three to six points the audience must accept to believe it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Turn each point into one slide whose headline is a complete sentence of no more than two lines that states the point, not the topic."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Under each headline, place the visual that best proves the sentence - a chart, diagram, photo, table or equation - and delete decorative images."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Strip the body text down to short labels on the visual; move anything you would have bulleted into what you say aloud or into a handout."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Read only the headlines in order and check that they tell the whole argument; fix any slide whose headline could not stand on its own."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/assertion-evidence-slides/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Rehearse explaining each visual in your own words rather than reading the headline back to the audience."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "Who will read or hear this - including people copied or forwarded to - and which of them is the one who must act?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "What does my primary audience already know, and which of my terms or steps would they not recognise?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "What is in this for them, and do they see it in the first few lines?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:audience-analysis"
   },
   "rdfs:label": "Have I checked my picture of the audience against something they actually said or did, or am I only guessing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Subject: Data migration finishing three weeks later than planned (no change to cost). The move to the new reporting system will finish on 4 December instead of 13 November. Your month-end reports will run on the old system as usual until then. Technical details for your IT team are in the section below.",
   "cmo:before": "Heads up - the ETL refactor slipped because the CDC connector kept OOMing on the backfill. New ETA is sprint 14, assuming infra gets us the bigger nodes.",
   "cmo:situation": "An engineering lead emails a delay notice about a data-platform migration to a list that includes the client's finance director.",
   "cmo:why": "The finance director is the primary reader and needs the date, the impact on her work and the cost; the jargon and team shorthand move to a separate section for the technical secondary audience."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto",
   "@type": "schema:HowTo",
   "schema:name": "Audience analysis",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "List every audience, not just the addressee - the decision maker, technical reviewers, people who are copied, people the message may be forwarded to and people affected by the outcome."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "For the primary audience, write down what they already know, what they care about, what attitude they are likely to bring and what they must decide or do after reading."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Check your assumptions against evidence - the questions people actually ask you, past replies, usage data or a short conversation with a typical reader."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Choose content, order, vocabulary, tone and channel to fit the primary audience, putting what matters to them first."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Give secondary audiences their own clearly labelled section instead of mixing material for different readers."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/audience-analysis/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Reread the draft as each audience in turn - including someone it might be forwarded to - and fix what would confuse or alienate them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:batna"
   },
   "rdfs:label": "Do I know concretely what I will do tomorrow if this negotiation ends without a deal?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:batna"
   },
   "rdfs:label": "Have I compared my alternative with the offer on equivalent terms, or only on the headline price?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:batna"
   },
   "rdfs:label": "Is my opening ask set by my goal, or have I let a weak alternative drag it down?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:batna"
   },
   "rdfs:label": "Is everything I am about to say about my alternatives true?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "We've priced a comparable tool that would cost us about 8% less in year one, including migration. We'd rather stay - the team knows your product - so we're looking for a renewal at last year's rate with the new reporting module included. What would make that work on your side?",
   "cmo:before": "We really can't move away from you, so please do what you can on the price. What's the best you can offer?",
   "cmo:situation": "An operations manager is renegotiating an annual software contract after the vendor proposes a 12% price rise.",
   "cmo:why": "The manager did the BATNA homework first (a real, like-for-like competing quote), so the ask is anchored on a goal rather than on desperation, the alternative is mentioned truthfully without a threat, and the question invites the vendor to solve the problem with them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto",
   "@type": "schema:HowTo",
   "schema:name": "BATNA",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/6"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/7"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before the first meeting, list every realistic thing you could do if no deal is reached - other vendors, other candidates, building it in-house, waiting, or doing nothing."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Translate each alternative into the same terms as the deal on the table (total cost, scope, risk, timing, effort to switch) so you are comparing like with like."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Pick the single best alternative - that is your BATNA - and from it set your reservation value, the worst deal you would still accept over walking away."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Spend some preparation time improving the BATNA itself (get a real competing quote, line up a second option) rather than only describing it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Estimate the other side's BATNA too, and ask about their alternatives, so you know how much they need this deal."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Anchor your opening ask on your goal, not on your BATNA; keep a weak BATNA to yourself and never invent an alternative you do not have."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/batna/howto/7",
   "@type": "schema:HowToStep",
   "schema:position": 7,
   "schema:text": "Re-check the BATNA whenever new information arrives during the talks, and walk away only when an offer is genuinely worse than it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "If my reader read only the subject line and first two sentences, would they know what I need from them and by when?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "Have I stated my conclusion or recommendation, or only described the situation and left the reader to infer it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:bottom-line-up-front"
   },
   "rdfs:label": "Is this message an exception - serious bad news, or a reader who expects context first - and have I chosen the structure on purpose?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Subject: Decision needed by Thursday - switch reporting vendor for Q1. Sam, I recommend we move the Q1 reports to our backup vendor; it adds about two weeks of setup but keeps the March board deadline. Please approve or decline by Thursday. Background: our current vendor's new platform cannot produce the quarterly export (confirmed on Tuesday's call), and deliveries have been late twice since September.",
   "cmo:before": "Hi Sam, I wanted to give you some background on the reporting vendor. Over the last two months we have seen several late deliveries, and after a call with their account team on Tuesday it looks like their new platform will not support our quarterly export. I have looked at a few options...",
   "cmo:situation": "A project analyst emails her director about a vendor problem that needs a decision.",
   "cmo:why": "The recommendation, the decision asked for and the deadline appear in the subject line and first two sentences, so the director can act without reading the history, which is still there for anyone who wants it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto",
   "@type": "schema:HowTo",
   "schema:name": "Bottom line up front",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before drafting, write one sentence that states your conclusion, recommendation or request, including any decision and deadline you need."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Make that sentence (after a short purpose statement if the format calls for one) the opening of the message, and echo it in the subject line or title."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Add only the background the reader needs to act on it, most important first, and move history and method to the end or an attachment."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Put any secondary requests or audiences in clearly labelled sections below the main point."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Reread only the first two lines and ask whether a busy reader could act on them alone; if not, rewrite them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/bottom-line-up-front/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Decide deliberately whether this message is an exception - serious bad news or a reader who expects context first - and if so use an indirect structure on purpose rather than by habit."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-level-gaze"
   },
   "rdfs:label": "Is my camera at or slightly above eye level, and is the other person's window right under it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-level-gaze"
   },
   "rdfs:label": "When I made my main point or my request, was I looking into the lens?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-level-gaze"
   },
   "rdfs:label": "Was I watching the other person's face while they spoke, rather than my own self-view or another screen?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-level-gaze"
   },
   "rdfs:label": "Am I forcing myself to stare at the lens so hard that I am losing track of what people are saying?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "The laptop is raised to eye level, the client's window sits just under the lens with brief notes beneath it, and the manager looks into the lens to say: we need two more weeks, and here is what you get for it. Then the manager watches the client's face while the client responds.",
   "cmo:before": "The laptop sits flat on the desk, the client's video is on a second monitor to the right, and the manager reads from notes on that monitor; the client sees someone looking down and away while asking for a two-week extension.",
   "cmo:situation": "A project manager presents a schedule change to a client on a video call.",
   "cmo:why": "Gaze below the lens is barely noticed while sideways gaze reads as looking away, and looking into the camera makes a speaker seem more sociable, so the request lands as direct and attentive."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto",
   "@type": "schema:HowTo",
   "schema:name": "Camera-level gaze on video calls",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Raise the camera to your eye level or slightly above, propping a laptop on books if you need to."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Sit about an arm's length back so you are framed from the chest up with your eyes roughly a third of the way down the frame."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Drag the video window of the person you are talking to up to the top centre of your screen, directly under the lens, rather than off to one side."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Look into the lens when you state your main point, make a request or ask a question, using a small sticker beside the lens as a reminder."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "While the other person is talking, watch their face in the window under the lens so you can read their reaction."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-level-gaze/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "If you need to glance at notes, keep them just below the camera so you look down briefly rather than sideways."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-optional-norm"
   },
   "rdfs:label": "Have I said out loud, or written in the invite, whether cameras are expected in this meeting and why?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-optional-norm"
   },
   "rdfs:label": "Would a new team member feel safe turning their camera off here, and have I told them so?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-optional-norm"
   },
   "rdfs:label": "Am I modelling the norm, or does my own always-on camera quietly signal that video is required?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:camera-optional-norm"
   },
   "rdfs:label": "When cameras are off, do I still give everyone a clear way to contribute?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Team charter line - 'Stand-up: cameras optional. Planning: cameras on for the first 10 minutes of check-in, optional after. 1:1s: your call.' The lead turns their own camera off after the check-in, calls on people by name, and tells new joiners in their first 1:1 that cameras-off is normal here.",
   "cmo:before": "Invite text - 'Cameras on please, it helps us stay connected.' The lead keeps a full gallery view, comments when a tile is dark, and the newest analysts never switch off even on their fourth call of the day.",
   "cmo:situation": "A team lead runs a daily 30-minute stand-up and two weekly hour-long planning calls for eight people, several of whom joined in the last three months.",
   "cmo:why": "The expectation is explicit and tied to the purpose of each meeting, the lead's behaviour shows the norm is real, and the people under the most self-presentation pressure hear it said to them directly, while the check-in keeps the group connection that buffers fatigue."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto",
   "@type": "schema:HowTo",
   "schema:name": "Camera-optional norm",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "List your recurring video meetings and decide for each whether faces add value - small working sessions, sensitive one-to-ones and first meetings with new people usually benefit; large updates, webinars and long all-hands rarely do."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Agree the camera expectation for each meeting type with the team, write it in the invite or team charter, and say plainly that cameras-off is fine wherever video is not needed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Tell newer colleagues directly, in person or one-to-one, that turning the camera off will not count against them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Model it as the organiser - switch your own camera off for part of a long meeting or for audio-only segments, because people follow what they see others doing."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Keep participation visible without video - ask people by name, use chat, reactions or a shared document, and agree that cameras-off still means no multitasking."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/camera-optional-norm/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "When video is used, suggest hiding self-view once framing is set, and build in short audio-only breaks in meetings longer than about 45 minutes."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:channel-selection"
   },
   "rdfs:label": "Am I mainly passing information on, or do we need to reach agreement - and does my channel fit that job?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:channel-selection"
   },
   "rdfs:label": "If my reader misread the tone of this text, what is the worst plausible interpretation, and would a call prevent it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:channel-selection"
   },
   "rdfs:label": "Am I choosing email or chat because it suits the message, or because it lets me avoid an awkward conversation?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:channel-selection"
   },
   "rdfs:label": "After a live discussion, have I put the decision, owners and dates in writing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Short email first - Subject: Decision needed Thursday - reporting module vs. March date. Priya, I'd like 20 minutes Wednesday to talk through a trade-off: keep the March date by moving the reporting module to April, or keep the module and slip to mid-April. One-page options summary attached. Then a 20-minute call to discuss, followed the same day by a written recap of the decision, owner and new dates.",
   "cmo:before": "Email, sent at 6 pm - Subject: Scope change. Hi Priya, given the integration issues we will need to drop the reporting module from the March release. Let me know if that works. Thanks.",
   "cmo:situation": "A project manager needs a client's sign-off to cut a feature so the release can stay on date, and the client sponsor is known to be attached to that feature.",
   "cmo:why": "The facts travel in writing where they can be reread, the contested decision happens live where questions and concerns surface immediately, and the written recap locks in the shared understanding the call produced."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto",
   "@type": "schema:HowTo",
   "schema:name": "Channel selection",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Name the job of the message in one line - is it mainly to pass on information the receiver can absorb alone (conveyance), or to agree on meaning, resolve disagreement or decide something together (convergence)?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "For conveyance - updates, data, instructions, reference material - default to a written, asynchronous channel the receiver can reread and process in their own time."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "For convergence - an ambiguous problem, a disagreement, a sensitive or emotional message, or a request you need someone to say yes to - default to a live channel with voice and fast feedback, such as a call, video or a face-to-face conversation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "If tone, sarcasm or humour carries part of the meaning, either move to voice or rewrite the text so the meaning survives without your tone of voice; read it aloud in a deliberately flat or opposite tone before sending."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Combine channels when the task needs both - send the facts in writing first, discuss live, then confirm the decision and owners in writing."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/channel-selection/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Check the receiver's side - their familiarity with you and the topic, time zone, norms and access - and adjust the default; a lean channel works better between people who already share context."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:communicating-uncertainty"
   },
   "rdfs:label": "Have I given a number or range where I have one, instead of a word like \"probably\" or \"should be fine\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:communicating-uncertainty"
   },
   "rdfs:label": "Have I said separately how good the evidence behind my estimate is?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:communicating-uncertainty"
   },
   "rdfs:label": "Have I told them what we do not yet know, what we are doing to find out and when we will know?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:communicating-uncertainty"
   },
   "rdfs:label": "Am I presenting real disagreement among experts or data as such, rather than smoothing it over or overplaying it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:communicating-uncertainty"
   },
   "rdfs:label": "Is the uncertainty in the sentence that carries the estimate, not in a footnote or a later slide?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/communicating-uncertainty/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Our best estimate is that 3% of accounts cancel in the first quarter, with a plausible range of 1-6%. The estimate rests on a four-week pilot in one region, so confidence is moderate. We will know much more after the second region's renewals on 15 March; until then I'd budget for 6%.",
   "cmo:before": "Churn should be fine - we don't expect much impact, though obviously nobody can be sure.",
   "cmo:situation": "A product lead tells the leadership team how many customers a pricing change will cost.",
   "cmo:why": "The before version mixes false reassurance with a blanket hedge, so leaders can neither plan nor challenge it; the after version gives a point estimate, a range, the quality of the evidence and when it will improve, which is what a decision needs."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:concession-strategy"
   },
   "rdfs:label": "Do I know my total concession budget and walk-away point before I make the first move?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:concession-strategy"
   },
   "rdfs:label": "For the concession I am about to make, what exactly am I asking for in return?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:concession-strategy"
   },
   "rdfs:label": "Have I said clearly what this move costs me, without exaggerating it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:concession-strategy"
   },
   "rdfs:label": "Are my steps getting smaller as I get closer to my limit, or am I making one big jump under pressure?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:concession-strategy"
   },
   "rdfs:label": "Have I acknowledged and reciprocated the concessions the other side has already made?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "I can't get to 15%, but I can offer 6% off the renewal, which comes out of our services margin. To make that work, we'd need a two-year term instead of one. If the two-year term is a problem, tell me what matters most and we can look at the payment schedule instead.",
   "cmo:before": "OK, we can do 15% off. Hopefully that works for your budget - shall I send the paperwork?",
   "cmo:situation": "A software vendor's account manager is renewing a contract with a client who has asked for a 15% discount.",
   "cmo:why": "The first reply gives away the whole concession budget at once, labels nothing and asks for nothing, so the client learns the price was soft and has no reason to give back. The second makes a smaller, named move tied to a specific return, leaves room for later steps, and invites the client to reveal what they value."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto",
   "@type": "schema:HowTo",
   "schema:name": "Concession strategy",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before the meeting, write down your opening position, your target and your walk-away point, and the total amount you are prepared to concede between them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "List what you want back for each possible concession - a longer term, faster payment, a reference, reduced scope - so you never give without a matching ask ready."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Plan the moves as a sequence of real steps that get smaller as you approach your limit, rather than one large jump, and hold some of the concession budget back."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "When you concede, name it - say what it costs you and what it gives them - and state exactly what you need in return, or make it explicitly conditional (\"we can do X if you can do Y\")."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Answer the other side's concessions in kind and on time; acknowledge them and move a proportionate amount, rather than pocketing them in silence."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/concession-strategy/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Keep every statement about your costs and limits true; stop conceding when the next step would cross your walk-away point."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:considering-others-contributions-first"
   },
   "rdfs:label": "Before I describe what I did on this project, have I named everyone else and what they did?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:considering-others-contributions-first"
   },
   "rdfs:label": "If each person on the team wrote down their share, would our numbers add up to more than 100%?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:considering-others-contributions-first"
   },
   "rdfs:label": "Whose work am I least likely to remember because it happened out of my sight?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:considering-others-contributions-first"
   },
   "rdfs:label": "If the list shows I carried more than others, am I raising the workload split for next time instead of keeping score?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "The launch shipped on time. Ana built the analytics dashboard, Raj rewrote the pricing page, Mei ran the legal review, and Tom handled the support handoff. I owned the rollout plan and coordinated the go/no-go calls.",
   "cmo:before": "I drove the launch end to end: I built the rollout plan, fixed the pricing page and got legal sign-off. Shipped on time.",
   "cmo:situation": "A project lead is drafting the end-of-quarter update to a director about a launch that five people worked on.",
   "cmo:why": "Listing colleagues first surfaces work the lead had half forgotten, gives the director an accurate picture of who to recognise, and still states the lead's real role plainly."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto",
   "@type": "schema:HowTo",
   "schema:name": "Considering others' contributions first",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before anyone states or estimates their own share of a piece of team work, write down the name of every person who contributed, including people outside the core team."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Next to each name, note one or two concrete things that person did, such as drafts written, analysis run, approvals chased or customers handled."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Only after the list is done, write your own contributions in the same concrete terms and estimate your share."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "If people give percentages, add them up; a total well above 100% is a signal that someone's work is being overlooked, not that someone is lying."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "In large teams, split the review by sub-team or workstream and make assignments explicit, so each person has fewer colleagues' contributions to recall."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/considering-others-contributions-first/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "When the list shows an uneven split, talk about how work will be divided next time rather than letting the person who carried more quietly resent it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/credibility/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:credibility"
   },
   "rdfs:label": "If I asked two trusted colleagues how credible I am on this topic, would their answer match mine?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/credibility/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:credibility"
   },
   "rdfs:label": "Does this audience doubt my expertise, my motives, or whether I care about their interests, and which one am I addressing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/credibility/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:credibility"
   },
   "rdfs:label": "Where I lack a track record, have I borrowed one through data, a pilot or a respected expert?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/credibility/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:credibility"
   },
   "rdfs:label": "Have I met the key people one-on-one to listen before asking them for anything?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/credibility/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:credibility"
   },
   "rdfs:label": "Am I stating limits and uncertainty plainly, or overselling in a way that will cost me trust later?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Which terms, acronyms or steps in this message did I learn on the job rather than expect my reader to know?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "If my reader had only this message and none of my background, what would they do next?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/curse-of-knowledge/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:curse-of-knowledge"
   },
   "rdfs:label": "Have I asked someone outside the work to restate my point in their own words, or am I only judging clarity myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/defensiveness/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:defensiveness"
   },
   "rdfs:label": "Am I about to describe what happened, or to deliver a verdict on the person who did it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/defensiveness/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:defensiveness"
   },
   "rdfs:label": "Have I signalled that the outcome is still open, or does my message sound like the decision is already made?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/defensiveness/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:defensiveness"
   },
   "rdfs:label": "When I felt criticised just now, did I restate their point before I explained or justified myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/defensiveness/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:defensiveness"
   },
   "rdfs:label": "Is the other person reacting to my content, or to a tone of superiority, certainty or hidden agenda they are picking up?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:describe-analyze-evaluate"
   },
   "rdfs:label": "Could someone who disagrees with me still accept my description of what happened as accurate?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:describe-analyze-evaluate"
   },
   "rdfs:label": "Have I written down more than one explanation, including one that would make this behaviour sensible where they come from?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:describe-analyze-evaluate"
   },
   "rdfs:label": "Which of my own norms am I using to judge this, and where did I learn it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:describe-analyze-evaluate"
   },
   "rdfs:label": "Am I about to give feedback that starts with my verdict instead of what I observed?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "In the last three reviews you didn't comment during the meeting, then emailed me concerns afterwards - and they were good ones. I can think of a few reasons that might happen. How do design disagreements usually get raised on teams you've worked on?",
   "cmo:before": "You're not engaging in reviews. If you disagree, say it in the room - sending emails afterwards looks like you're going around the team.",
   "cmo:situation": "A team lead in a global project notices that a newly transferred engineer never raises objections in design reviews and later sends concerns privately by email.",
   "cmo:why": "The first version presents an evaluation (\"not engaging\", \"going around the team\") as fact; the second states the observable pattern, admits several possible explanations and asks before judging, so the engineer can explain a norm the lead may not share."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto",
   "@type": "schema:HowTo",
   "schema:name": "Describe-analyze-evaluate",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/5"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "When a colleague's behaviour surprises or irritates you, pause before replying and write down only what you saw or heard, in words a camera could confirm."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "List at least two or three different explanations for that behaviour, including at least one that would make it reasonable in the other person's context."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Name your own evaluation and its source - what you feel about the behaviour and which norm you are measuring it against."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Check the most important explanation with the person or a cultural informant using a neutral question built on your description."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/describe-analyze-evaluate/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Only then decide how to respond, and if you give feedback, lead with the description rather than the evaluation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/direct-vs-indirect-feedback/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:direct-vs-indirect-feedback"
   },
   "rdfs:label": "If I strip out the softeners or intensifiers, what is the core message I am sending - and would this listener decode it the same way?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/direct-vs-indirect-feedback/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:direct-vs-indirect-feedback"
   },
   "rdfs:label": "Am I about to deliver criticism in front of people who do not need to hear it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/direct-vs-indirect-feedback/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:direct-vs-indirect-feedback"
   },
   "rdfs:label": "Have I checked what the person understood, rather than assuming my politeness or bluntness landed as intended?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/egocentric-bias/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:egocentric-bias"
   },
   "rdfs:label": "If someone outside my team read this message cold, what would they need that I am carrying only in my head?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/egocentric-bias/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:egocentric-bias"
   },
   "rdfs:label": "Have I asked the other person what they think, or am I just imagining their view and trusting my guess?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/egocentric-bias/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:egocentric-bias"
   },
   "rdfs:label": "Before I say how much I did on this project, have I listed what each other person contributed?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/egocentric-bias/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:egocentric-bias"
   },
   "rdfs:label": "Am I assuming my tone is obvious in this email because I can hear it in my own head?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/ethnocentrism/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:ethnocentrism"
   },
   "rdfs:label": "When I called a colleague's message rude, vague or odd, was I measuring it against how people communicate where I learned to work?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/ethnocentrism/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:ethnocentrism"
   },
   "rdfs:label": "Would I rate this candidate's or manager's competence the same if their accent, style and background matched mine?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/ethnocentrism/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:ethnocentrism"
   },
   "rdfs:label": "Have I asked what this behaviour means in the other person's context before deciding what it means?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/ethnocentrism/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:ethnocentrism"
   },
   "rdfs:label": "Who on this team have I quietly been avoiding or routing around, and is the real reason a difference in style?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/eye-contact/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:eye-contact"
   },
   "rdfs:label": "Was I looking at the other person mostly while they were speaking, and letting my gaze move while I was thinking?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/eye-contact/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:eye-contact"
   },
   "rdfs:label": "Did I hold anyone's gaze long enough that it might have felt like a stare or a challenge?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/eye-contact/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:eye-contact"
   },
   "rdfs:label": "Did I share my eye contact around the room, or did I keep looking only at the most senior person?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/eye-contact/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:eye-contact"
   },
   "rdfs:label": "Is this person's comfort with direct gaze likely to differ from mine, and did I adjust to what they did?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/face-to-face-conversation/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:face-to-face-conversation"
   },
   "rdfs:label": "Is this a request, a disagreement, an ambiguous problem or sensitive news - the kinds of message that land better in person?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/face-to-face-conversation/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:face-to-face-conversation"
   },
   "rdfs:label": "Am I choosing email because it suits the message, or because it spares me an awkward conversation?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/face-to-face-conversation/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:face-to-face-conversation"
   },
   "rdfs:label": "Have I picked a private place and enough time, rather than catching the person in a corridor or open-plan area?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/face-to-face-conversation/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:face-to-face-conversation"
   },
   "rdfs:label": "Before we part, have we said the decision and next steps out loud, and will I confirm them in writing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/facilitation/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:facilitation"
   },
   "rdfs:label": "Before we started, did the group agree the goal, the agenda and how we would take turns, or did I assume everyone knew?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/facilitation/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:facilitation"
   },
   "rdfs:label": "Who got cut off or stayed silent, and did I hand the floor back to them by name?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/facilitation/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:facilitation"
   },
   "rdfs:label": "Did I summarise where we had landed before moving to the next item, and check that the summary was right?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/facilitation/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:facilitation"
   },
   "rdfs:label": "Did I keep my own opinions out of the content, or did I steer the group toward the answer I wanted?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/facilitation/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:facilitation"
   },
   "rdfs:label": "Did the meeting end with named owners and next steps for each decision?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedback-sandwich"
   },
   "rdfs:label": "Is my praise specific and sincere, or am I using it only to cushion the criticism?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedback-sandwich"
   },
   "rdfs:label": "If the person repeated back only one sentence from this conversation, would it be the correction?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedback-sandwich"
   },
   "rdfs:label": "Am I sandwiching because the feedback needs it, or because I am uncomfortable saying it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedback-sandwich"
   },
   "rdfs:label": "Do the people I manage now brace for a \"but\" whenever I praise them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Your market-sizing section is the strongest I've seen from a new analyst - the sources are solid. The main fix: the recommendation is on slide 14, so the client won't see it until the end; move it to slide 2 and let the rest support it. Your data work makes that recommendation easy to defend. What do you think of moving it?",
   "cmo:before": "Great job overall, really nice work! Just one tiny thing, maybe think about the order a bit? But honestly it's great, the client will love it.",
   "cmo:situation": "A team lead reviewing an analyst's first client slide deck, which is well researched but hides the recommendation on slide 14.",
   "cmo:why": "The first version wraps a vague correction in generic praise, so the analyst may hear only \"great job\"; the rewrite keeps the positive-corrective-positive shape but makes every part specific, states the fix as an action, and checks it landed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto",
   "@type": "schema:HowTo",
   "schema:name": "Feedback sandwich",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Decide whether a sandwich is needed at all - routine corrections in a healthy working relationship can be given on their own, and praise can be given separately when it is earned."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Pick one specific, important correction; if there are several, the issue is bigger than a sandwich and needs a fuller conversation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Open with sincere praise for a specific behaviour you want the person to keep, ideally related to the same piece of work."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "State the correction plainly as an observable behaviour, not a judgement of the person, and offer a concrete alternative."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Close with genuine, specific encouragement - not a generic compliment - and invite the person to respond, then paraphrase what they say."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedback-sandwich/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Afterwards, check that the correction was heard by asking what they will do differently next time."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedforward"
   },
   "rdfs:label": "Have I named one behaviour I want to improve in the future, rather than asking for a verdict on the past?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedforward"
   },
   "rdfs:label": "When a suggestion arrived, did I say \"thank you\" - or did I explain why it would not work?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedforward"
   },
   "rdfs:label": "Am I using feedforward to avoid a conversation about a real problem that still needs to be discussed?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:feedforward"
   },
   "rdfs:label": "Which of the suggestions will I actually try, and have I told the people who gave them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "I'm working on running kick-offs that finish on time. Could you give me two ideas I could try at the next one? I'll just note them down - no need to go back over last week.",
   "cmo:before": "Can you give me some feedback on last week's kick-off? I know it ran 40 minutes over, but the client kept raising scope questions, so honestly I'm not sure what I could have done differently.",
   "cmo:situation": "A project manager whose kick-off meetings regularly overrun wants to improve before the next quarter's projects start.",
   "cmo:why": "The first version invites a debate about a past meeting and opens with a defence, so the colleague has to argue to be helpful; the rewrite names a future goal, asks for a bounded number of ideas and promises not to argue, which makes it easy to offer useful suggestions."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto",
   "@type": "schema:HowTo",
   "schema:name": "Feedforward",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Pick one specific behaviour you want to get better at, phrased as a future goal (\"run tighter project kick-offs\"), not a past failure."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Describe that goal briefly to a colleague who has seen you work or who knows the subject - they do not need to be your manager."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Ask for two concrete suggestions for the future, and make clear you are not asking for a review of anything that already happened."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Listen and write the suggestions down without judging, explaining or defending - the only permitted reply is \"thank you\"."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Offer to return the favour - ask what they want to improve and give them two forward-looking suggestions in turn."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/feedforward/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Repeat with a few different people, then choose the suggestions you will actually try and tell those colleagues what you changed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/filled-pauses/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:filled-pauses"
   },
   "rdfs:label": "In my last recorded talk, how many \"ums\" and \"uhs\" did I use per minute - closer to two or to twelve?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/filled-pauses/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:filled-pauses"
   },
   "rdfs:label": "Do my fillers cluster at the start of answers to questions, where a planned first sentence would remove them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/filled-pauses/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:filled-pauses"
   },
   "rdfs:label": "When I lose my place, can I let two seconds of silence pass instead of filling it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/filled-pauses/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:filled-pauses"
   },
   "rdfs:label": "Am I trying to remove every single filler, when a few are normal and cost me little?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/filled-pauses/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "The launch moves to the 20th. [pause] The cause is a late security review from our vendor. [pause] It finished yesterday, so the 20th is firm.",
   "cmo:before": "So, um, basically the, uh, launch is, like, moving out a bit, um, because of, uh, the vendor thing, so, um, yeah, we're, uh, looking at maybe the 20th.",
   "cmo:situation": "A product manager gives a two-minute status update to a leadership meeting and is asked why the launch slipped.",
   "cmo:why": "The speaker replaces each filler with a short silent pause and plans one sentence at a time, so the answer is shorter, the date comes first, and the hesitation that suggested doubt is gone."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:first-offer"
   },
   "rdfs:label": "Do I know the likely range of agreement better than, as well as, or worse than the other side?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:first-offer"
   },
   "rdfs:label": "Is my opening based on my target and a reason I can say out loud, rather than on my walk-away point?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:first-offer"
   },
   "rdfs:label": "Is it ambitious enough to leave room to move but not so extreme that it could offend or end the talks?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:first-offer"
   },
   "rdfs:label": "Am I about to reveal a preference we probably share, which they could trade back to me as a concession?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:first-offer"
   },
   "rdfs:label": "If they opened first, have I re-anchored on my own numbers before replying?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Based on the three proposals we reviewed for similar scope, we'd like to propose $8,500 a month for six months, with the weekly dashboard and quarterly review included. That reflects the market and a six-month commitment from us. How does that sit with you?",
   "cmo:before": "We don't have a fixed budget yet - what would you normally charge for something like this?",
   "cmo:situation": "A marketing team lead is buying a six-month analytics retainer from a small agency she has researched; similar retainers she found ranged from $8K to $11K a month.",
   "cmo:why": "She knows the market range at least as well as the agency, so moving first lets her set the reference point near the low end with a stated rationale, instead of inviting the agency to anchor at the top of the range."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto",
   "@type": "schema:HowTo",
   "schema:name": "First offer",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before the conversation, research the market and estimate the zone of possible agreement - your walk-away point, the other side's likely walk-away point, and what comparable deals settled at."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Decide whether to move first - do so when you know the range at least as well as the other side; if they clearly know more, ask questions and let them open."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Set the offer from your ambitious target, not from your walk-away point, and make sure it is one you can justify with a real reason."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Limit the opening to the issues where your interests conflict; hold back terms you suspect both sides want anyway until you have learned their preferences."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "State the number precisely and confidently, give the reason in one or two sentences, then stop talking and listen."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/first-offer/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "If they open first, do not respond to their number straight away - restate your own target, their likely limits and your alternatives to yourself, then counter from your plan rather than from their anchor."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/grices-maxims/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:grices-maxims"
   },
   "rdfs:label": "If my reader took every word literally and also read between the lines, what would they conclude that I did not intend?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/grices-maxims/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:grices-maxims"
   },
   "rdfs:label": "Did I use a weaker word such as \"some\", \"most\" or \"should\" where a stronger one was true, and so imply the stronger one is false?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/grices-maxims/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:grices-maxims"
   },
   "rdfs:label": "Does every sentence I am about to send answer the question that was actually asked?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/grices-maxims/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:grices-maxims"
   },
   "rdfs:label": "Have I stated anything I believe but cannot back up, without flagging it as a belief?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/grices-maxims/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:grices-maxims"
   },
   "rdfs:label": "Is there detail here the reader does not need to act, and detail they need that I left out?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:habit-reversal-training"
   },
   "rdfs:label": "Do I know my actual filler rate from a recording, or am I guessing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:habit-reversal-training"
   },
   "rdfs:label": "Can I name the exact sound or word I am trying to replace, and where it usually appears?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:habit-reversal-training"
   },
   "rdfs:label": "When I felt a filler coming in that talk, did I pause silently instead?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:habit-reversal-training"
   },
   "rdfs:label": "Have I tested the new habit in front of a real audience, not just alone with a recorder?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Revenue was up 8% this quarter. [brief pause] The main driver was renewals.",
   "cmo:before": "Um, so revenue was, uh, up this quarter, um, about 8%, and, uh, the main driver was, um, the renewals.",
   "cmo:situation": "A team lead must present quarterly results to a department of 40 and has noticed she says \"um\" constantly in rehearsals.",
   "cmo:why": "After three 15-minute sessions of spotting her fillers on recordings and practising a silent pause instead, she catches the urge before it becomes a sound, so each sentence starts clean and the number lands first."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto",
   "@type": "schema:HowTo",
   "schema:name": "Habit reversal training",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Record two or three short practice talks and count your fillers per minute to get a baseline."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Write a one-line description of the habit you are targeting, such as \"um\" or \"uh\" at the start of a sentence."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Replay a recording and mark every filler the moment you hear it, until you catch nearly all of them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Practise the competing response - close your mouth and take a brief silent pause - each time you feel a filler coming."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Give a new practice talk, ideally with a colleague tapping the table when you miss one, and recount your rate."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/habit-reversal-training/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Repeat a short booster session before high-stakes talks if your rate drifts back up."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:humble-inquiry"
   },
   "rdfs:label": "Did I ask at least one question I did not already know the answer to?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:humble-inquiry"
   },
   "rdfs:label": "Was my question a real question, or a suggestion or a test dressed up as one?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:humble-inquiry"
   },
   "rdfs:label": "Who talked more in that conversation, and did I learn anything that changed my view?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:humble-inquiry"
   },
   "rdfs:label": "Did I acknowledge what they said before telling them what I think?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "You built this differently from our usual deck - I'd like to understand why. Can you walk me through what you were going for and what you know about this client that I might not?",
   "cmo:before": "This isn't the template we use. Please redo it in the standard deck format tonight so we're ready for tomorrow.",
   "cmo:situation": "A team lead notices a direct report delivered a client analysis in an unexpected format, a day before the client review.",
   "cmo:why": "The first version assumes the lead already knows everything relevant and shuts the report down; the second surfaces their reasoning (perhaps the client asked for it), keeps them engaged, and still leaves time to agree a format together."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto",
   "@type": "schema:HowTo",
   "schema:name": "Humble inquiry",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before the conversation, write down what you are assuming about the situation and the person, and mark which parts you have not actually checked."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Open with a question you do not know the answer to (\"Walk me through how you approached this\") instead of your verdict or fix."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Stop after the question and let the other person talk; resist filling the first silence with your own view."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Ask one genuine follow-up that builds on what they just said, rather than steering back to your agenda."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Acknowledge what you heard in your own words before you add any opinion, request or decision."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/humble-inquiry/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Only then tell - share your view or ask for what you need - and invite them to correct or add to it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:i-statements"
   },
   "rdfs:label": "Have I described a specific behaviour I could point to, or slipped in a label, a motive or an \"always\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:i-statements"
   },
   "rdfs:label": "Is my \"I feel…\" a real feeling, or a disguised accusation such as \"I feel that you don't care\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:i-statements"
   },
   "rdfs:label": "Have I said anything that shows I understand the other person's side of the situation?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:i-statements"
   },
   "rdfs:label": "After I speak, am I ready to listen to their reaction rather than repeat my point louder?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "I know Mondays are packed for you with the support queue. When the status update reaches me after 9 a.m. on call days, I can't check the numbers before we present them, and I get anxious that we'll give the client something wrong. Could we agree on Friday afternoon as the cut-off?",
   "cmo:before": "You never get your updates in on time. You're making the whole team look unprepared in front of the client.",
   "cmo:situation": "A project lead raises a recurring problem with a colleague who sends status updates late on the morning of the weekly client call.",
   "cmo:why": "The rewrite replaces a character verdict (\"never\", \"you're making\") with one observable behaviour, its concrete effect and the speaker's own feeling, acknowledges the colleague's constraint, and ends with a specific request - the combination the 2018 rating study found least likely to provoke defensiveness."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto",
   "@type": "schema:HowTo",
   "schema:name": "I-statements",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before speaking, name one specific, observable behaviour (what was said or done, and when) instead of a trait or a pattern word like \"always\" or \"never\"."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Work out the concrete, tangible effect that behaviour has on you or your work - time lost, rework, a missed commitment."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Identify the feeling underneath, and check whether anger is masking something more precise such as worry or frustration."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Say it in the first person in roughly this order - behaviour, effect, feeling - and, if useful, a request for what you would like instead."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Add one sentence that shows you see the other person's side (their constraints, intentions or pressures) before or after your own view."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/i-statements/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Stop and listen; expect some defensiveness, reflect back what you hear, and send a clearer second I-statement only if the first one was not understood."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/illusion-of-transparency/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:illusion-of-transparency"
   },
   "rdfs:label": "Have I actually said the thing I am assuming they already picked up from my tone or face?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/illusion-of-transparency/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:illusion-of-transparency"
   },
   "rdfs:label": "In this email, would a reader who could not hear my voice know whether I was joking, annoyed or serious?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/illusion-of-transparency/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:illusion-of-transparency"
   },
   "rdfs:label": "Did I check what they understood, or did I take their nod as proof?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/illusion-of-transparency/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:illusion-of-transparency"
   },
   "rdfs:label": "Before this presentation, am I treating my racing heart as something the audience can see?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:influence-without-authority"
   },
   "rdfs:label": "Do I know what this person is measured on and worried about right now, or am I guessing?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:influence-without-authority"
   },
   "rdfs:label": "What can I offer that they would value, and is it something I can genuinely deliver?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:influence-without-authority"
   },
   "rdfs:label": "Have I separated what I must have from what would merely be nice?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:influence-without-authority"
   },
   "rdfs:label": "Would I be comfortable if they saw exactly how I planned this request, or does it rely on spin?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Hi - I know your team is measured on the release shipping cleanly, so I don't want to add risk. Of the six events, two are essential for the launch review (sign-up and first purchase); the rest can wait a sprint. I've written the event specs and test cases so it should be about an hour of work, and I'll credit your team in the launch metrics readout to the VP. Would Wednesday morning work, or is there a better slot?",
   "cmo:before": "Hi, I need these six tracking events added before Thursday's release. It's important for the launch, so please prioritise it. Thanks!",
   "cmo:situation": "A product analyst needs an engineer on another team to add tracking events before a launch, but has no authority over the engineer's priorities.",
   "cmo:why": "The rewrite shows an understanding of the engineer's goals, cuts the ask to what is essential, lowers the cost by doing the preparatory work, and offers currencies the engineer may value (less effort, visibility with leadership) instead of borrowing urgency the analyst has no standing to impose."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto",
   "@type": "schema:HowTo",
   "schema:name": "Influence without authority",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Treat the person whose help you need as a potential ally, even if past dealings were tense, and drop any story that they are simply difficult."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Write down exactly what you need from them, which parts are essential and which are nice to have, and check that the request serves the work rather than only your own ambitions."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Diagnose their world - how they are measured and rewarded, what their boss expects, what their workload and pressures are this quarter."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "List the currencies they are likely to value (resources, information, help, recognition, visibility, a link to a larger purpose) and the ones you can actually offer, including cheap ones you control yourself."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Assess the relationship; if trust is low, repair it first, and adapt to how they prefer to work (data or story, email or a quick call)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/influence-without-authority/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Make a concrete, honest offer that trades something they value for what you need, then deliver on it and keep in touch afterwards so the relationship exists before you need it again."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/information-overload/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:information-overload"
   },
   "rdfs:label": "Does every person on this distribution list need to act on or know this, or am I copying them to cover myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/information-overload/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:information-overload"
   },
   "rdfs:label": "Could the reader act on my first two lines without opening the attachment?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/information-overload/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:information-overload"
   },
   "rdfs:label": "Am I adding a fifth channel or thread for something that already has a home?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/information-overload/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:information-overload"
   },
   "rdfs:label": "Have I told my team when I do and do not expect replies, so nobody feels they must watch the inbox all day?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/information-overload/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:information-overload"
   },
   "rdfs:label": "When I feel swamped, is it the volume of messages, or a lack of clear priorities behind them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:integrative-negotiation"
   },
   "rdfs:label": "Have I put more than one issue on the table, or am I haggling over a single number?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:integrative-negotiation"
   },
   "rdfs:label": "Do I know which issues matter most to the other side, or am I assuming their interests are the opposite of mine?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:integrative-negotiation"
   },
   "rdfs:label": "Am I trading low-priority terms for high-priority ones, rather than conceding issue by issue?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:integrative-negotiation"
   },
   "rdfs:label": "Am I sharing information step by step and checking that it is reciprocated?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:integrative-negotiation"
   },
   "rdfs:label": "Is there a package that would leave both of us better off than the one we are about to sign?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Help me understand what's driving the 8% - is it a revenue target for this year, or the cost of supporting us? On our side, budget certainty matters more than anything, and we're flexible on contract length. If we signed for three years instead of one, and agreed to be a reference customer, could you hold this year's price flat with a capped increase after that?",
   "cmo:before": "An 8% increase isn't going to work for us. Can you meet us halfway at 4%?",
   "cmo:situation": "An IT manager is negotiating a software renewal with a vendor account executive who has proposed an 8% price increase.",
   "cmo:why": "Splitting the difference treats the renewal as a single fixed pie; asking about the vendor's interests and offering terms that are cheap for the buyer but valuable to the vendor (a longer commitment, a reference) lets both sides gain more than a 4% compromise would give them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto",
   "@type": "schema:HowTo",
   "schema:name": "Integrative negotiation",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/6"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/7"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before the conversation, list every issue that could be on the table - not only price, but timing, scope, payment terms, staffing, risk sharing, duration - and add issues if there is only one."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Rank those issues by how much each matters to you, and note your BATNA so you know the point below which no package is worth taking."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Open by asking why, not what - ask what the other side needs to achieve, what constraints they face and which terms matter most to them - and listen for differences in priority."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Share some of your own priorities in return, a piece at a time, watching whether the other side reciprocates before you disclose more."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Propose trades across issues - give ground on what you value less in exchange for movement on what you value more - instead of meeting in the middle on each issue separately."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Bundle the trades into complete packages and test them with \"what if\" questions, using objective criteria such as market rates to settle the remaining distributive pieces."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/integrative-negotiation/howto/7",
   "@type": "schema:HowToStep",
   "schema:position": 7,
   "schema:text": "Before closing, ask whether any other arrangement would leave both sides better off than the one on the table."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/interrupting/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:interrupting"
   },
   "rdfs:label": "Did I start talking before the other person had finished their sentence or their point?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/interrupting/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:interrupting"
   },
   "rdfs:label": "When I came in over someone, was it to agree and build on what they said, or to change the subject or win the argument?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/interrupting/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:interrupting"
   },
   "rdfs:label": "In this meeting, who got cut off early, and did anyone, including me, hand the floor back to them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/interrupting/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:interrupting"
   },
   "rdfs:label": "If I was interrupted, did I calmly reclaim the turn (\"Let me finish this point, then I'd like your view\")?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/interrupting/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Analyst: 'The Q3 numbers don't reconcile because the vendor changed—' Lead: [waits until she stops] 'So the vendor changed something in the feed. What changed, and what does it mean for the forecast?'",
   "cmo:before": "Analyst: 'The Q3 numbers don't reconcile because the vendor changed—' Lead: 'Yeah, vendors always do that, let's just use last quarter's file. Next item.'",
   "cmo:situation": "In a weekly project meeting, a junior analyst starts explaining why the vendor data looks wrong, and the team lead jumps in.",
   "cmo:why": "In the first version the lead takes the floor mid-sentence and closes the topic, so the analyst loses both the point and the standing to raise it again; in the second he lets her finish, summarises, and hands the floor back, so the actual cause surfaces."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:issue-selling"
   },
   "rdfs:label": "Can I state in one sentence which of leadership's existing goals this issue helps, and is that link honest?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:issue-selling"
   },
   "rdfs:label": "Am I bringing a proposed solution and the evidence my leaders usually ask for, or only a complaint?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:issue-selling"
   },
   "rdfs:label": "Who else have I involved, and would any of them be surprised to hear me raise it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:issue-selling"
   },
   "rdfs:label": "Is this the right moment and forum, or am I raising it because I am frustrated right now?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:issue-selling"
   },
   "rdfs:label": "If they say no, what will I do next - and am I prepared to accept that answer?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Proposal for Thursday's ops review: about a third of last month's support tickets trace to the billing page. A two-sprint redesign, already scoped with product, would cut handling costs and supports this year's customer-retention goal. I'd like a decision on adding it to Q1. One-page case attached; finance has checked the numbers.",
   "cmo:before": "Hi all, I wanted to flag (again) that the billing page is a mess. My team is drowning in tickets and nobody seems to care. Can we please prioritise this?",
   "cmo:situation": "A support team lead wants leadership to fund a fix for a confusing billing page that drives a large share of tickets.",
   "cmo:why": "The rewrite ties the issue to a goal leaders own, brings data and a solution, shows peers are already involved, and uses a scheduled forum - the packaging, involvement and process moves the research links to success - instead of venting frustration."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto",
   "@type": "schema:HowTo",
   "schema:name": "Selling issues to leadership",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/6"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/7"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Write the issue in one sentence and link it to a goal, metric or priority your leaders already own, framed as an opportunity where honestly possible."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Find out how the decision maker likes to receive proposals - data or story, a written pre-read or a conversation - and what evidence counts in your organisation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Build a short business case - cost, benefit, risk and what happens if nothing changes - and bring at least one concrete proposed solution, not only the problem."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Test the idea with peers and one or two respected senior people first; fold in their objections and ask who should be involved or informed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Read the context before you raise it - is leadership listening, under pressure, or recently burned by a similar idea? - and pick a moment and channel that fit."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Raise it calmly, acknowledge any past decision you are revisiting without blaming whoever made it, and ask for one specific next step."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/issue-selling/howto/7",
   "@type": "schema:HowToStep",
   "schema:position": 7,
   "schema:text": "Follow up, report what happened, and decide deliberately whether to persist, re-bundle the issue with another priority, or let it go for now."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Can I name my manager's top two goals and the pressure they are under this quarter, from what they have told me rather than my guess?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Do I know whether my manager would rather read this in writing first or hear it live, and am I using that format?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Have we explicitly agreed what \"done\" looks like and when they want to hear from me, or am I assuming?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Is there a problem or slipping date I have not told them about yet, and why am I waiting?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Am I spending their time and goodwill on something that truly needs them, and have I brought a proposed solution?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/managing-up/check/6",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:managing-up"
   },
   "rdfs:label": "Would I be comfortable if my manager saw exactly how I prepared for this conversation, or does it rely on flattery or spin?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:meeting-agendas"
   },
   "rdfs:label": "Could each attendee tell from the agenda alone what the meeting must decide and what they should prepare?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:meeting-agendas"
   },
   "rdfs:label": "Is every item phrased as a question that needs this whole group, or could some be handled by email?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:meeting-agendas"
   },
   "rdfs:label": "Did the agenda reach people early enough for them to actually prepare?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:meeting-agendas"
   },
   "rdfs:label": "At the end, can I point to an answer for each question on the agenda?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Purpose: agree the move plan. 1. (Decide, Priya, 15 min) Which two weeks in March should we move? 2. (Seek input, Tom, 20 min) Under what conditions should we reallocate desks to hybrid staff? 3. (Share, me, 5 min) What changes for parking? Please read the floor plan before Tuesday.",
   "cmo:before": "Agenda: 1. Office move update 2. Desk allocation 3. AOB",
   "cmo:situation": "A team lead schedules a 45-minute meeting with six colleagues about next quarter's office move.",
   "cmo:why": "Questions show what counts as done, the labels tell people whether they are deciding or just listening, and the named owners and pre-reading let them arrive prepared instead of reacting cold."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto",
   "@type": "schema:HowTo",
   "schema:name": "Meeting agendas",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Ask the people who will attend what they need the meeting to settle, and include only items that need this whole group."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Write each item as a question the group must answer, not a topic label."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Mark each item as share, seek input or decide, and name who leads it and how many minutes it gets."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Use the questions to set the invite list - invite only the people needed to answer them - and cancel if you cannot write any questions."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Circulate the written agenda, with any pre-reading, far enough ahead for people to prepare."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/meeting-agendas/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Open the meeting by restating its purpose, follow the agenda, and end when the questions are answered."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:multiple-equivalent-simultaneous-offers"
   },
   "rdfs:label": "Are my packages really equivalent in value to me, or have I hidden a preferred option among decoys?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:multiple-equivalent-simultaneous-offers"
   },
   "rdfs:label": "Is every package above my walk-away point and more ambitious than my target?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:multiple-equivalent-simultaneous-offers"
   },
   "rdfs:label": "Have I kept it to two or three options so the other side can compare them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:multiple-equivalent-simultaneous-offers"
   },
   "rdfs:label": "Am I ready to respond to cherry-picking with new packages instead of single concessions?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:multiple-equivalent-simultaneous-offers"
   },
   "rdfs:label": "Is everything I say about the packages - including that I would accept any of them - true?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "We've put together three options we'd be glad to do. A: 12 weeks, $240K, two analysts on site, monthly billing. B: 16 weeks, $255K, one analyst on site plus remote support, quarterly billing. C: 10 weeks, $215K, two analysts, with your team owning the dashboard build. Which of these fits your budget cycle and team best - or which is closest?",
   "cmo:before": "Our proposal is a 12-week engagement at $240K, paid monthly, with two analysts on site. Let us know if that works.",
   "cmo:situation": "A consulting manager is proposing terms for a follow-on analytics engagement to a client's procurement lead.",
   "cmo:why": "Each package is worth roughly the same to the firm, so any choice is acceptable; the client gets a real choice instead of a take-it-or-counter offer, and their pick reveals whether they care most about price, duration or internal capacity."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto",
   "@type": "schema:HowTo",
   "schema:name": "Multiple equivalent simultaneous offers",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "List every issue that is genuinely negotiable (price, scope, timing, payment terms, support, duration) and give each a weight that reflects how much it matters to you."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "For each issue, write the realistic range of options and score them so that options you prefer earn more points."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Build two or three complete packages that score about the same in total for you but trade the issues off differently - for example, higher price with faster delivery versus lower price with a longer commitment."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Check every package against your BATNA and make all of them more ambitious than your target, so there is still room to move."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Present the packages together, say you would be comfortable with any of them, and ask which one fits the other side best - or, if none does, which is closest and why."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/multiple-equivalent-simultaneous-offers/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Treat their choice as information about their priorities; if they combine the best parts of different packages, reply with a fresh set of equivalent packages rather than conceding piece by piece."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:nominal-group-technique"
   },
   "rdfs:label": "Is my question specific enough that people could write concrete answers to it on their own?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:nominal-group-technique"
   },
   "rdfs:label": "Did I protect the silent-writing and round-robin phases from early debate or evaluation, including my own?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:nominal-group-technique"
   },
   "rdfs:label": "Did each person rank privately, so seniors' preferences were not visible before others voted?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:nominal-group-technique"
   },
   "rdfs:label": "Is this really a single-question, prioritise-and-decide meeting, or does the topic need open exploration first?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Take ten minutes and write down, on your own, every process problem that slows you down. Then we'll go round the table one idea at a time, I'll number them, and everyone ranks their top five privately before we talk priorities.",
   "cmo:before": "Okay, open floor - what should we fix first? ... Great point, Sam [senior lead], the ticketing tool is a mess. Anyone disagree? No? Let's go with that.",
   "cmo:situation": "An operations manager runs a one-hour meeting with eight team members, including two senior leads, to decide which process problems to fix first next quarter.",
   "cmo:why": "The open floor lets the first senior voice anchor the room and blocks quieter people from offering ideas; silent writing and private ranking let every member contribute and weigh in equally before status and conversation shape the outcome."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto",
   "@type": "schema:HowTo",
   "schema:name": "Nominal group technique",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Write one specific, open question on the board or shared screen and read it aloud, for example \"What are the biggest obstacles to closing month-end two days faster?\""
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Give everyone 10-20 minutes of silent, individual writing to list as many answers as they can, with no talking."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Run a round robin - each person reads out one idea per turn, which you record verbatim and number - and keep going until the lists are exhausted; allow no debate yet."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Walk through the numbered list for clarification only, letting anyone explain an item, and merge true duplicates with the agreement of the people who raised them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Ask each person to privately pick and rank their top five items (5 points for the most important down to 1), then tally the scores in front of the group."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/nominal-group-technique/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Discuss the top-ranked items and the surprises in the tally, and, if the scores are close, run a second private vote before you commit to next steps."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:open-ended-questions"
   },
   "rdfs:label": "Could the other person have answered my question with one word, and was that what I really wanted?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:open-ended-questions"
   },
   "rdfs:label": "Did my next question build on their answer, or did I jump to my own agenda?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:open-ended-questions"
   },
   "rdfs:label": "Did I ask a \"why\" question where a \"what\" or \"how\" would have felt less like a demand for justification?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:open-ended-questions"
   },
   "rdfs:label": "When I needed a firm answer on a specific risk, did I ask a direct, specific question instead of a vague one?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "What's the part of the migration you're least confident about right now?",
   "cmo:before": "Is the migration still on track for the end of the month?",
   "cmo:situation": "A team lead checks in with an engineer on a database migration that has gone quiet for a week.",
   "cmo:why": "The closed question invites a reflexive \"yes\"; the open one asks for an explanation and presumes there is some uncertainty, which makes it easier to surface a problem early."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto",
   "@type": "schema:HowTo",
   "schema:name": "Open-ended questions",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Decide what you actually need to learn - their view, the obstacles, the options - before you ask anything."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Open with \"what\" or \"how\" (\"What's getting in the way?\", \"How did the client react?\") instead of \"Is\", \"Do\" or \"Did\"."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Stop talking and let them answer fully; resist offering a suggested answer if they pause."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Build your next question on what they just said (\"You mentioned the handover - what happened there?\") rather than switching topic."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Reflect back what you heard before asking another question, so the exchange does not become an interrogation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/open-ended-questions/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Switch to a closed or specific question when you need a commitment, a number, or a straight answer to a known risk (\"Will this slip past the 30th?\")."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:paraphrasing"
   },
   "rdfs:label": "Did I restate their point in my own words, or did I just repeat their phrases back like a parrot?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:paraphrasing"
   },
   "rdfs:label": "Did I capture what mattered to them and how they felt, not only the facts?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:paraphrasing"
   },
   "rdfs:label": "Did I end with a genuine check (\"Have I got that right?\") and accept a correction without defending myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:paraphrasing"
   },
   "rdfs:label": "Did I hold back my own view until they agreed I had understood them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "So if I've understood you, the Tuesday deliveries land on the same morning as the weekly stock count, which means your team either delays the count or leaves trucks waiting - and you're worried we'll start paying demurrage. Is that the main problem, or is there more to it?",
   "cmo:before": "The schedule was signed off by procurement last month, so we really can't change it now. Let's just make it work.",
   "cmo:situation": "An operations lead tells a project manager that the new vendor's delivery schedule will not work for the warehouse, and the PM's instinct is to defend the schedule.",
   "cmo:why": "The rewrite restates the specific facts and the concern behind them in the PM's own words and invites correction, so the operations lead can confirm or fix the picture before anyone argues for a solution."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto",
   "@type": "schema:HowTo",
   "schema:name": "Paraphrasing",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Listen to the whole point without planning your reply; note the facts, what the speaker seems to feel and what seems most important to them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Wait for a natural pause, then restate the core of their message in one or two sentences, using your own words rather than echoing theirs."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Where feelings are clearly present, name the feeling and its cause tentatively (\"it sounds like the late change left you frustrated\")."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "End with a check question such as \"Have I got that right?\" or \"What did I miss?\" and accept corrections without arguing."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "If they correct you, paraphrase the corrected version; follow up with an open question if something is still unclear."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/paraphrasing/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Only once they confirm you have understood, give your own perspective, answer or proposal."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/perspective-taking/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:perspective-taking"
   },
   "rdfs:label": "Can I state what the other person is trying to achieve and what constrains them, without using my own goals?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/perspective-taking/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:perspective-taking"
   },
   "rdfs:label": "Which of my beliefs about their view did I actually hear from them, and which did I only imagine?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/perspective-taking/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:perspective-taking"
   },
   "rdfs:label": "What one question would confirm or overturn my best guess about their position?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/perspective-taking/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:perspective-taking"
   },
   "rdfs:label": "Am I trying to understand their reasoning, or just feeling sorry for them in a way that will make me give ground I need?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/perspective-taking/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:perspective-taking"
   },
   "rdfs:label": "Has imagining their side made me more suspicious or more competitive than the facts warrant?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Who exactly is reading this, and what do they already know about the subject?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Which terms here did I learn inside my team or field, and have I replaced or defined each one where it first appears?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/plain-language/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:plain-language"
   },
   "rdfs:label": "Could a reader say in their own words what I want them to do next?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:presentation-rehearsal"
   },
   "rdfs:label": "Have I said the whole talk out loud, standing, at least once from start to finish?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:presentation-rehearsal"
   },
   "rdfs:label": "Do I know how long it actually runs, from a timed run-through rather than a guess?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:presentation-rehearsal"
   },
   "rdfs:label": "Has anyone other than me heard it and told me what was unclear?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:presentation-rehearsal"
   },
   "rdfs:label": "Did I rehearse with the same slides, notes and setup I will use on the day?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "On Monday she talks the deck through aloud and finds it runs 14 minutes, so she cuts two slides. On Tuesday she records a run, notices she reads the slides with her back to the camera, and fixes it. On Wednesday three peers sit in; one asks about churn, so she adds a backup slide. Thursday's talk ends at nine minutes.",
   "cmo:before": "She builds the deck on Wednesday night, clicks through it silently twice at her desk, and on Thursday runs four minutes over, loses her place on slide 6 and has no answer when the CFO asks about churn.",
   "cmo:situation": "A product manager has a 10-minute slot to propose a pricing change to the leadership team on Thursday.",
   "cmo:why": "Rehearsing aloud exposed the timing problem, the recording exposed a delivery habit she could not feel, and a live audience surfaced the question leadership was likely to ask - none of which silent clicking would reveal."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto",
   "@type": "schema:HowTo",
   "schema:name": "Presentation rehearsal",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Start at least several days ahead and split practice into short sessions (opening, body, close) rather than one late-night cram."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Rehearse the whole talk out loud, standing, at full volume, with the slides or notes you will actually use."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Time every full run-through and cut material until you finish comfortably inside the slot."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Record one run on your phone, watch it back, and note one or two specific delivery habits to fix."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Give at least one run-through to a small live audience - three or four colleagues - and ask each for one thing that was unclear and one thing to keep."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/presentation-rehearsal/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Do a final rehearsal in the real room or on the real video setup, then stop practising and sleep."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:pyramid-principle"
   },
   "rdfs:label": "Could my reader state my conclusion after reading only the first paragraph and the headings?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:pyramid-principle"
   },
   "rdfs:label": "Does every point under a heading actually support that heading, and are my groups free of overlaps and gaps?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:pyramid-principle"
   },
   "rdfs:label": "Am I presenting the order in which I did the work, or the order in which my reader needs the answer?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Recommendation: standardise coolant pressure on all six machines; we expect tooling costs to return to last year's level within a quarter. Situation: the machines ran within budget until spring. Complication: tooling costs have since risen sharply. Question: what should we change? Three findings support the answer - 1) the cost rise tracks the machines with low coolant pressure, 2) a two-week trial at higher pressure cut tool wear, 3) the change needs no new equipment. Data for each is in the sections below.",
   "cmo:before": "Report on tooling costs. Week 1: we collected cost data from all six machines. Week 2: we ran tests on feed rates and coolant. Week 3: we analysed the results and found several interesting patterns, which are described below, followed by some options we considered...",
   "cmo:situation": "An operations analyst writes up a three-week investigation into rising machine-tooling costs for the plant manager.",
   "cmo:why": "The rewrite moves from the order the analyst worked in to the order the reader thinks in - answer, then grouped reasons, then evidence - so the manager can decide from the first paragraph and check any reason in its own section."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto",
   "@type": "schema:HowTo",
   "schema:name": "Pyramid principle",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/5"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Before drafting, write the single sentence you want the reader to accept or act on - your answer, not your topic."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Write the question that sentence answers, and the situation and complication that make the reader ask it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "List every supporting point, then sort them into two to four groups that each answer \"why?\" or \"how?\" about the top sentence."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Check each group - its points should be the same kind of idea, not overlap, and together cover the claim - and put them in a deliberate order (time, structure or importance)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/pyramid-principle/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Turn each group into a summary sentence and a heading, place the evidence under it, and reread the top sentence and headings alone to see whether they tell the whole story."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:raci-matrix"
   },
   "rdfs:label": "For this decision, can everyone involved name the one person who makes the final call?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:raci-matrix"
   },
   "rdfs:label": "Is each person I have marked Consulted someone whose input could actually change the outcome?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:raci-matrix"
   },
   "rdfs:label": "Do the people marked Informed know when and how they will hear the result?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Release notes - R: tech writer drafts. A: product manager approves and publishes. C: lead engineer checks accuracy by Wednesday. I: support team gets the final text on release day.",
   "cmo:before": "Release notes - owners: Eng, Marketing, Support (everyone please review before we publish).",
   "cmo:situation": "A product team keeps arguing about who signs off on customer-facing release notes; marketing, support and engineering all edit them and the notes ship late.",
   "cmo:why": "One named approver ends the circular edits, the single consulted reviewer has a deadline, and support knows it will be told rather than needing to chase or review."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto",
   "@type": "schema:HowTo",
   "schema:name": "RACI matrix",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "List the recurring tasks and decisions that cause confusion as rows, and the roles involved as columns."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "For each row, name exactly one Accountable owner - the person who signs off or makes the call."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Mark who is Responsible for doing the work, keeping it to as few people as possible."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Mark Consulted only for people whose input must be heard before the work is finished, and Informed for people who need the outcome afterwards."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Scan the finished grid for rows with no A, several As, many Rs or a long list of Cs, and fix them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/raci-matrix/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Share the grid with everyone named, agree it together, and use the C and I columns as the contact list for updates."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/rapport/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:rapport"
   },
   "rdfs:label": "Did I give this person my full attention, or was part of me on my screen or my next point?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/rapport/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:rapport"
   },
   "rdfs:label": "Did I learn one thing about them as a person before we got into the business?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/rapport/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:rapport"
   },
   "rdfs:label": "Before a hard negotiation or tense thread, have we ever spoken live, even for five minutes?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/rapport/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:rapport"
   },
   "rdfs:label": "Did the setting and their cues invite small talk, or did they signal they wanted to get straight to work?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/rapport/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:rapport"
   },
   "rdfs:label": "Am I trying to connect, or performing techniques such as copying their posture?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:readability-formulas"
   },
   "rdfs:label": "Did I change any sentence only to move the score rather than to help a reader?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:readability-formulas"
   },
   "rdfs:label": "Which formula and tool produced this number, and did I strip headings and lists before scoring?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:readability-formulas"
   },
   "rdfs:label": "Has anyone from the intended audience tried to use this document, and what did they get wrong?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "To book leave, submit the leave form in the HR portal at least two weeks ahead. Your manager approves it, HR checks your balance, and you get an email when it is booked.",
   "cmo:before": "Leave. Approval needed. Submit form. Use portal. Manager signs. HR checks. Then booked.",
   "cmo:situation": "A policy team is told every staff notice must score at or below grade 8 before it goes out.",
   "cmo:why": "The choppy version scores as very easy but leaves readers guessing about order, deadline and who acts; the revised version scores slightly harder yet answers the questions readers actually have."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto",
   "@type": "schema:HowTo",
   "schema:name": "Readability formulas",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Decide who the readers are and what they must find, understand and do before you look at any score."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Prepare the text for scoring by removing headings, bullet fragments, tables, URLs and other non-prose that calculators miscount."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Run one named formula in one tool and record which you used, so later scores are comparable."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Treat a high score only as a pointer to passages worth rereading for long sentences and unfamiliar terms; fix those for the reader, not for the number."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Never chop sentences or swap in short but vague words just to lower the score."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/readability-formulas/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Check the revised draft with a few real or representative readers (ask them to find an answer or explain the next step) and let their results, not the score, decide whether it is ready."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:reciprocal-self-disclosure"
   },
   "rdfs:label": "Did we take roughly equal turns, or did one of us do almost all the talking or all the asking?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:reciprocal-self-disclosure"
   },
   "rdfs:label": "When they shared something, did I answer at about the same depth before asking my next question?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:reciprocal-self-disclosure"
   },
   "rdfs:label": "Did I go deeper only after they matched the last level, or did I jump ahead to something too personal?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:reciprocal-self-disclosure"
   },
   "rdfs:label": "Given my status relative to them, was what I shared likely to build connection rather than cost me credibility?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Lead: 'How's the first week landing?' Contractor: 'Good - still learning the codebase, it's huge.' Lead: 'It took me a month to stop getting lost in it; the billing module was my nemesis. Which part has been hardest so far?' The contractor names one, adds that they're new to the city, and the lead mentions a lunch spot the team likes before heading to the stand-up.",
   "cmo:before": "The lead asks eight questions in a row - background, tools, location, weekend plans - and shares nothing. Or, in the opposite version, spends fifteen minutes on their own career story and a stressful family week.",
   "cmo:situation": "A team lead's first coffee chat with a contractor who has just joined the project.",
   "cmo:why": "Each person shares a little and then gets the floor back, the lead matches the contractor's level of detail, and the lead's disclosure is a past struggle that is now solved rather than a current weakness."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto",
   "@type": "schema:HowTo",
   "schema:name": "Self-disclosure reciprocity",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Open with a light question tied to the shared situation, then listen for what the other person chooses to reveal."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Answer their disclosure with one of your own at a similar level of personal detail - not a bigger story, not a deflection."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Hand the turn back with a question that builds on what they just said, so speaking and listening alternate in short exchanges."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Deepen one notch at a time (facts, then preferences, then experiences) only after the other person has matched the previous level."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "If you are senior to the other person, share interests, experiences or lessons learned rather than current weaknesses or anxieties, and keep task-relevant shortcomings for settings that call for them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/reciprocal-self-disclosure/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Close the exchange while it is still balanced, and note one thing they told you to follow up on next time."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:risk-numbers-as-natural-frequencies"
   },
   "rdfs:label": "Have I stated the reference group (\"out of every 1,000 ...\") before giving any count?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:risk-numbers-as-natural-frequencies"
   },
   "rdfs:label": "Can my listener see how many cases are false alarms, not just how many real cases are caught?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:risk-numbers-as-natural-frequencies"
   },
   "rdfs:label": "Am I comparing options with the same denominator and in absolute terms rather than \"doubled\" or \"halved\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:risk-numbers-as-natural-frequencies"
   },
   "rdfs:label": "Does every number in my sentence clearly belong to one named group?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:risk-numbers-as-natural-frequencies"
   },
   "rdfs:label": "If someone asked \"so of the ones flagged, how many are real?\", have I already answered it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Out of every 10,000 orders, about 20 are fraudulent and the model flags 18 of them. Of the other 9,980 legitimate orders it also flags about 500. So of roughly 518 flagged orders, only 18 - about 1 in 30 - are fraud. Auto-cancelling would block about 500 good customers to stop 18 bad ones; I suggest manual review instead.",
   "cmo:before": "The model catches 90% of fraud with only a 5% false-positive rate, so a flagged order is very likely fraudulent - I'd auto-cancel them.",
   "cmo:situation": "A risk analyst briefs the head of operations on whether to auto-cancel every order a new fraud model flags.",
   "cmo:why": "The before version quotes the model's accuracy and invites the listener to ignore how rare fraud is; the counts make the base rate and the false alarms visible, so the leader can see that most flags are wrong and decide on that basis."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto",
   "@type": "schema:HowTo",
   "schema:name": "Risk numbers as natural frequencies",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Pick one reference group large enough that every count comes out as a whole number (1,000 or 10,000 is usual) and name it in the first sentence."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Split that group by the base rate first - how many have the condition, defect or event and how many do not."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Apply the detection or hit rate inside the first subgroup and the false-alarm rate inside the second, and write each result as a count."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Answer the decision question as \"X out of Y\" - for example, how many of all flagged cases are real - instead of quoting the test's accuracy."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Keep the same denominator for every option you compare, and give absolute changes (\"from 20 to 10 in 1,000\") rather than relative ones (\"halved\")."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/risk-numbers-as-natural-frequencies/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Tie every number to its group in the wording (\"of the 9,980 legitimate orders, about 500 are flagged\") and, for a live audience, sketch the counts as a simple frequency tree."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:role-reversal"
   },
   "rdfs:label": "Could the other person hear my summary of their position and say \"yes, that's it\" without correcting me?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:role-reversal"
   },
   "rdfs:label": "Did I describe their reasons and worries, or only their demand?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:role-reversal"
   },
   "rdfs:label": "Are our positions actually incompatible, or have we just misunderstood each other - and has the swap made that clearer?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:role-reversal"
   },
   "rdfs:label": "Am I using the swap to understand them, or to rehearse a rebuttal?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:role-reversal"
   },
   "rdfs:label": "If I argued their side to someone who shares their values, would it sound persuasive or like a caricature?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "PM - Let me try your side first. You're worried that launching two days before the freeze leaves no window to roll back, and your on-call team absorbed the last two late launches. Is that right? Ops - Mostly; the bigger issue is we have no runbook yet. Now let me do yours: sales made a commitment to a named customer and slipping costs you credibility. PM - Yes. So can we ship to that one customer behind a flag and do the full launch after the freeze?",
   "cmo:before": "PM - We have to ship on the 28th; sales has promised it. Ops - You always do this, and my team pays for it on call. PM - It's a small change, you're overreacting.",
   "cmo:situation": "A product manager and an operations lead are stuck on whether to launch a feature before the quarter-end freeze.",
   "cmo:why": "Each side states the other's concern until the owner agrees it is fair, which surfaces the real blocker (no runbook) and a shared fact (one customer matters most), and opens an option neither raised while they were only defending their own positions."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto",
   "@type": "schema:HowTo",
   "schema:name": "Role reversal",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Agree the ground rule before the discussion starts - each person summarises the other's position, and the other confirms or corrects it, before anyone argues back."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Let each side state its own position once, briefly and without interruption."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Swap - each person presents the other's position in the first person (\"As the ops lead, my concern is...\") covering their goal, their reasons and what worries them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Ask the original owner to rate the summary and fill in anything missing or distorted; repeat until they say it is fair."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Only then argue your own case, starting from the points you now know you share and naming the points that still genuinely conflict."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/role-reversal/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "When preparing alone for a hard negotiation, write or rehearse the other party's brief in their voice and test which of your own arguments would actually move them."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:scheduled-inbox-checks"
   },
   "rdfs:label": "Do the people who depend on me know when I will see their message and how to reach me if it cannot wait?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:scheduled-inbox-checks"
   },
   "rdfs:label": "Did I actually close the inbox and turn off alerts between check-ins, or just check less while staying distracted?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:scheduled-inbox-checks"
   },
   "rdfs:label": "In this check-in, did I decide what to do with each message, or did I just read and leave them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:scheduled-inbox-checks"
   },
   "rdfs:label": "Is my message volume high enough that batching helps, or am I adding rigidity for little gain?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:scheduled-inbox-checks"
   },
   "rdfs:label": "Has turning alerts off made me more anxious about missing something, and if so would hourly checks suit me better?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Email and chat alerts off; inbox processed at 9:00, 13:00 and 16:30. The analyst's status and email signature say: 'I check messages three times a day - for anything urgent on the forecast, call my desk line.'",
   "cmo:before": "Outlook open all day with pop-up alerts on; the analyst answers each message within minutes and does forecast work in the gaps between replies.",
   "cmo:situation": "A finance analyst gets 120 emails and a steady flow of chat pings a day and is preparing a quarterly forecast that needs long stretches of concentration.",
   "cmo:why": "Fewer checks cut the interruptions that fragment the forecast work, and the stated urgent path stops colleagues guessing or escalating, which addresses the co-worker expectations the original study could not control."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto",
   "@type": "schema:HowTo",
   "schema:name": "Scheduled inbox checks",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Look at how often you check messages today and what your role genuinely needs; if you are on call or in a live-support role, agree an exception path before you change anything."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Pick a small number of fixed check-in times (three a day is the most-tested dose) and block them in your calendar, sized to your usual volume."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Between check-ins, close the email tab or app and switch off desktop and phone alerts for email and non-urgent chat."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "During each check-in, triage in one pass - reply, delegate, schedule or archive - rather than reading messages and leaving them for later."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Tell your team and key stakeholders when you check messages and how to reach you for anything genuinely urgent (a phone call or a named chat channel)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/scheduled-inbox-checks/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Review after two weeks - stress, missed items, response complaints - and adjust the number of check-ins rather than abandoning the routine."
  },
  {
