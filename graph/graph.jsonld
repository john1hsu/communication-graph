   ],
   "rdfs:label": "Zone of possible agreement",
   "skos:altLabel": [
    "ZOPA",
    "bargaining zone",
    "contract zone"
   ],
   "skos:broader": [
    {
     "@id": "cm:distributive-negotiation"
    },
    {
     "@id": "cm:negotiation-preparation"
    }
   ],
   "skos:definition": "The range of deals that both sides would prefer to walking away - the overlap between each party's reservation point. If the ranges overlap a deal is possible; if they do not, no amount of haggling will produce one and both sides should turn to their alternatives.",
   "skos:inScheme": {
