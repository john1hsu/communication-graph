  {
   "@id": "cm:zoom-fatigue",
   "@type": "cmo:Barrier",
   "cmo:challengedBy": {
    "@id": "cm:bennett-et-al-2021"
   },
   "cmo:demonstratedBy": [
    {
     "@id": "cm:riedl-et-al-2023"
    },
