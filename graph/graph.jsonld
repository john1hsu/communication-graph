     "@id": "cm:shockley-et-al-2021"
    }
   ],
   "cmo:domain": "digital-and-async-communication",
   "cmo:evidenceStatus": "mixed",
   "cmo:explainedBy": {
    "@id": "cm:nonverbal-overload"
   },
   "cmo:file": "articles/digital-and-async-communication/zoom-fatigue.md",
   "cmo:level": "introductory",
   "cmo:supportedBy": {
    "@id": "cm:fauville-et-al-2023"
   },
