  {
   "@id": "https://github.com/john1hsu/communication-graph/id/source/anchoring-and-adjustment/s1",
   "@type": "cmo:Source",
   "cmo:sourceType": "peer-reviewed",
   "dcterms:date": {
    "@type": "xsd:date",
