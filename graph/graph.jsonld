   "rdfs:label": "Direct vs. indirect feedback",
   "skos:altLabel": [
    "direct and indirect negative feedback",
    "evaluating scale",
    "feedback directness",
    "upgraders and downgraders"
   ],
   "skos:broader": [
    {
     "@id": "cm:feedback"
    },
    {
     "@id": "cm:intercultural-communication"
    }
   ],
   "skos:definition": "The contrast between stating criticism plainly, often intensified with \"upgraders\" such as \"totally\", and softening it with \"downgraders\", understatement or omission so the listener infers the problem; norms differ across cultures, but research shows the gap shifts with setting, status and urgency rather than following nationality alone.",
   "skos:inScheme": {
