   "rdfs:label": "Illusion of transparency",
   "skos:altLabel": [
    "overestimating how obvious we are",
    "transparency illusion"
   ],
   "skos:broader": {
    "@id": "cm:egocentric-bias"
   },
   "skos:definition": "The tendency to overestimate how clearly other people can see our internal states - our nerves, feelings and intentions - and, by extension, how plainly our messages convey what we meant, so we under-signal and fail to check understanding.",
