   "rdfs:label": "Plain language",
   "skos:altLabel": [
    "clear language",
    "plain English",
    "plain writing"
   ],
   "skos:broader": {
    "@id": "cm:clarity"
   },
   "skos:definition": "The principle of writing so that the intended readers can find what they need, understand it and use it the first time they read it, by writing for that audience in familiar words, clear structure and direct sentences.",
   "skos:inScheme": {
