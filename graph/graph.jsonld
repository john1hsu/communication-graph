   "rdfs:label": "Curse of knowledge",
   "skos:altLabel": [
    "curse of expertise",
    "expert blind spot"
   ],
   "skos:broader": {
    "@id": "cm:egocentric-bias"
   },
   "skos:definition": "The difficulty of imagining what it is like not to know something you know, which leads informed people to overestimate what their audience already understands and to communicate in shorthand, abstractions and skipped steps.",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/communication-graph/id/scheme/barriers-and-psychology"
