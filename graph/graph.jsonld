   "rdfs:label": "I-statements",
   "skos:altLabel": [
    "I feel statements",
    "I-language",
    "I-messages",
    "confrontive I-message"
   ],
   "skos:broader": {
    "@id": "cm:assertive-communication"
   },
   "skos:definition": "Raising a problem by describing the other person's specific behaviour, its concrete effect on you and how you feel about it, phrased from your own point of view (\"I…\") rather than as an accusation or verdict about them (\"You always…\").",
   "skos:inScheme": {
    "@id": "https://github.com/john1hsu/communication-graph/id/scheme/difficult-conversations-and-conflict"
   },
