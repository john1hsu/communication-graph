    "@value": "2026-11-03"
   },
   "prov:wasDerivedFrom": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/william-strunk-jr/s1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/source/william-strunk-jr/s2"
    },
