  {
   "@id": "https://github.com/john1hsu/communication-graph/id/speaking-anxiety/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:speaking-anxiety"
   },
   "rdfs:label": "Am I declining this presentation because it is not my job, or because I am afraid of it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/speaking-anxiety/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:speaking-anxiety"
   },
   "rdfs:label": "Have I rehearsed this out loud, standing, at least once - or only read my notes silently?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/speaking-anxiety/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:speaking-anxiety"
   },
   "rdfs:label": "Am I assuming the audience can see my nerves as clearly as I can feel them?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/speaking-anxiety/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:speaking-anxiety"
   },
   "rdfs:label": "What is the one point I need them to leave with, if everything else goes badly?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/speaking-anxiety/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:speaking-anxiety"
   },
   "rdfs:label": "Afterwards, am I judging the talk by how I felt or by what the audience actually did with it?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/spotlight-effect/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:spotlight-effect"
   },
   "rdfs:label": "Am I staying quiet because I think everyone will remember this one comment, when they are mostly thinking about their own contributions?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/spotlight-effect/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:spotlight-effect"
   },
   "rdfs:label": "If a colleague had made the slip I just made, would I still be thinking about it tomorrow?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/spotlight-effect/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:spotlight-effect"
   },
   "rdfs:label": "Am I about to spend the first minute of my talk apologising for something the audience has not noticed?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/spotlight-effect/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:spotlight-effect"
   },
   "rdfs:label": "If I picture this meeting from the back of the room instead of through my own eyes, how big does my moment really look?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:stakeholder-mapping"
   },
   "rdfs:label": "Who could stop or slow this, and have I spoken to them directly rather than assuming their view?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:stakeholder-mapping"
   },
   "rdfs:label": "Who will be most affected but has the least say, and how will they hear about it before it lands?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:stakeholder-mapping"
   },
   "rdfs:label": "Does each group's message answer their concern, or is it the same message I would send everyone?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:stakeholder-mapping"
   },
   "rdfs:label": "When did I last update this map, and has anyone's stance or influence changed since?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Map: Finance director (high power, high interest, undecided) - weekly check-in, co-own the cut-over date. Payroll lead (high power, low interest) - one briefing on the export file, sign-off by week 3. Frequent travellers in sales (low power, high interest, worried about slower refunds) - invite two to test in week 2, answer the refund-time question in every message. Everyone else - short email at go-live and a two-minute video.",
   "cmo:before": "Plan: send one all-staff email two weeks before go-live announcing the new tool, with a link to the user guide.",
   "cmo:situation": "An operations manager is replacing the team's expense-claims tool and has a go-live date in six weeks.",
   "cmo:why": "The single email treated everyone as one audience; the map shows who can block the launch, who will feel it most and what each needs to hear, so the manager spends attention where a surprise would be costly."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto",
   "@type": "schema:HowTo",
   "schema:name": "Stakeholder mapping",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Write down the decision or change in one sentence and set the boundary - which teams, customers, regulators and time frame are in scope."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "List everyone who can affect it or will be affected by it, then ask two or three colleagues outside your team who is missing, including people with little voice."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "For each stakeholder, note their main interest or concern, whether they currently support, oppose or are undecided, and what power they hold (budget, sign-off, expertise, reputation, ability to block)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Place each one on a power-versus-interest grid and pick an engagement level - partner closely, keep satisfied, consult, or keep informed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "For each group, decide who will talk to them, the one message that speaks to their interest, the channel and how often - then put that in a communication plan."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/stakeholder-mapping/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Test the map by talking to the stakeholders themselves, and revisit it at each milestone, because power, interest and stance shift."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:status-reporting"
   },
   "rdfs:label": "Would someone who knew everything I know give this project the same rating I have?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:status-reporting"
   },
   "rdfs:label": "Is there a risk I am privately worried about that does not appear in this report, and why have I left it out?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:status-reporting"
   },
   "rdfs:label": "Does the first line tell a busy sponsor whether they need to act, and by when?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:status-reporting"
   },
   "rdfs:label": "Am I reporting change against the approved baseline, or only selecting the numbers that look good this week?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "Status: AMBER (was GREEN). Go-live on 2 March is at risk: 22% of migrated customer records fail validation, and at the current fix rate cleanup finishes about three weeks late. Done so far: vendor engaged, root cause traced to duplicate legacy IDs. Options: (a) add two analysts for four weeks (about $18K) and hold the date; (b) move go-live to 23 March at no extra cost. Recommendation: (a). Decision needed from the steering group by Friday.",
   "cmo:before": "Status: GREEN. Good progress this sprint - 14 of 18 integration tests passing. Some data-quality items being worked through with the vendor; we remain confident about the timeline and will update next report.",
   "cmo:situation": "A team lead on a six-month CRM migration sends a fortnightly status report to the steering group; a data-quality problem has put the go-live date at risk.",
   "cmo:why": "The rewrite applies the agreed rating honestly, quantifies the problem instead of hiding it in reassurance, shows what has already been done, and turns the bad news into a decision the readers can make while there is still time to act."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto",
   "@type": "schema:HowTo",
   "schema:name": "Project status reporting",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Agree with the sponsor, in writing, what each status rating means (for example what turns a project amber or red) before the first report goes out."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Open with the overall rating, the one-line reason for it and any decision you need, with a date."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Report against the approved baseline for time, cost, scope and benefits, and show the change since the last report rather than only the current position."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "For each significant issue, state the cause, what you have already done, the options and your recommendation."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Raise a slipping milestone in the first report where you believe it is at risk, not the one where it is missed."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/status-reporting/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "After each review, ask the reader whether the report gave them what they needed and adjust the format, not the facts."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:teach-back"
   },
   "rdfs:label": "Did I ask them to say it in their own words, or did I accept a nod or a \"makes sense\"?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:teach-back"
   },
   "rdfs:label": "Did I frame the check as testing my explanation, not their competence?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:teach-back"
   },
   "rdfs:label": "Which one or two points would cause real damage if misunderstood, and did I check those?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:teach-back"
   },
   "rdfs:label": "When their restatement was off, did I re-explain differently rather than repeat myself louder?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "I've thrown a lot at you, so let me check I explained it well. If the patch fails on Thursday, what are your next two moves, and who hears from you first?",
   "cmo:before": "So that's the background - escalate to Priya's team if the patch fails, and keep the client posted. Does that all make sense?",
   "cmo:situation": "A team lead hands over an urgent client escalation to a colleague before going on leave.",
   "cmo:why": "The yes/no check invites a polite \"yes\"; the open request surfaces the missing piece (who to call first) while the lead can still fix it, and frames any gap as the explainer's problem."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto",
   "@type": "schema:HowTo",
   "schema:name": "Teach-back",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Pick the one to three points the other person must get right to act - a deadline, a decision, a sequence of steps - rather than checking everything."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Explain each point in plain, specific language, one point at a time."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Take ownership of the check out loud, for example \"I want to make sure I explained that clearly.\""
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Ask an open request to restate or demonstrate (\"How will you walk the client through this?\"), never a yes/no question such as \"Does that make sense?\""
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Listen for gaps or errors; if you hear one, re-explain that part differently and ask again until their version is accurate."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/teach-back/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Close by confirming the agreed version in writing where it matters (a recap message or ticket)."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/video-call-communication/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:video-call-communication"
   },
   "rdfs:label": "Does this conversation need faces and live back-and-forth, or would a phone call, a shared document or a short written update do?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/video-call-communication/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:video-call-communication"
   },
   "rdfs:label": "If the goal is to generate ideas, have I given people a way to think away from the screen, or should we meet in person?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/video-call-communication/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:video-call-communication"
   },
   "rdfs:label": "Is my audio clear enough that a stranger would take me seriously, and have I fixed it before worrying about my background?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/video-call-communication/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:video-call-communication"
   },
   "rdfs:label": "Did I tell people at the start how to ask to speak and in what order I will take contributions?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/video-call-communication/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:video-call-communication"
   },
   "rdfs:label": "After I asked a question, did I leave enough pause for the lag before filling the silence or moving on?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:wait-time"
   },
   "rdfs:label": "After my last question, did I actually stay silent for at least three seconds, or did I rephrase, add options or answer it myself?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:wait-time"
   },
   "rdfs:label": "When someone finished speaking, did I pause before replying, or did I jump straight to my next point?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:wait-time"
   },
   "rdfs:label": "Did the answers I got come mostly from the fastest speakers, and would more think time have widened who spoke?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:wait-time"
   },
   "rdfs:label": "When I was asked something difficult, did I take a moment to think, or did I answer to escape the silence?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "What slowed us down most on this release? I'll give everyone a few seconds to think before we start. [silent count to five] ... [after Priya answers, another three-second pause] ... Anything else behind that?",
   "cmo:before": "So, what slowed us down? ... Was it the test environment? Or maybe the late spec changes? OK, Priya, the environment, right? Great - next item.",
   "cmo:situation": "A product manager runs a project retrospective with six engineers and wants to hear what really slowed the release.",
   "cmo:why": "In the first version the manager fills the silence with guesses and accepts the first answer, so the group responds to his options; the pauses in the second version give quieter people time to form a view and give the first speaker room to add the underlying cause."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto",
   "@type": "schema:HowTo",
   "schema:name": "Wait time",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Ask one question, then stop talking - do not rephrase it, add a second question or offer a sample answer."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Count silently to at least three (longer for a hard or open question, or when a group is involved) before saying anything else."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "If the silence runs on, re-invite rather than rescue - \"Take a moment; I'd rather hear a considered answer\" - and keep waiting."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "When the person finishes answering, pause again for a few seconds before you reply, so they can add the second thought that often matters most."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "In a meeting, say up front that you will wait before taking answers, so the first fast voice does not set the direction."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/wait-time/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "When you are asked a hard question, give yourself the same pause - say you want a moment to think - instead of filling the gap with the first answer that comes to mind."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:words-of-estimative-probability"
   },
   "rdfs:label": "If three readers each wrote down the percentage they think my likelihood word means, would their numbers land in the same range as mine?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:words-of-estimative-probability"
   },
   "rdfs:label": "Have I put the number next to the word, or am I relying on readers to look up a key they will probably skip?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:words-of-estimative-probability"
   },
   "rdfs:label": "Am I using \"could\", \"may\" or \"possible\" to hedge when I actually have an estimate I am reluctant to commit to?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:words-of-estimative-probability"
   },
   "rdfs:label": "Have I kept my confidence in the evidence separate from the likelihood of the event?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/example",
   "@type": "cmo:Rewrite",
   "cmo:after": "We judge it unlikely (20-45%) that we hit the March 1 go-live; very likely (80-95%) by March 22. We have moderate confidence: the estimate rests on two weeks of test-defect data. Decision needed by Friday: hold the date with reduced scope, or move it.",
   "cmo:before": "There is a real possibility we could miss the March 1 go-live, although the team is working hard and it may well still be achievable.",
   "cmo:situation": "A consultant updates a client steering committee on whether a system migration will hit its go-live date.",
   "cmo:why": "The before version could be read anywhere from a small risk to a probable slip; the after version gives one shared range, separates odds from confidence, and turns the forecast into a decision the committee can make."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto",
   "@type": "schema:HowTo",
   "schema:name": "Words of estimative probability",
   "schema:step": [
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/1"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/2"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/3"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/4"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/5"
    },
    {
     "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/6"
    }
   ]
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/1",
   "@type": "schema:HowToStep",
   "schema:position": 1,
   "schema:text": "Agree a short likelihood scale with your team or client before you need it - for example remote (under 5%), unlikely (20-45%), roughly even (45-55%), likely (55-80%), very likely (80-95%) - with ranges that do not overlap."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/2",
   "@type": "schema:HowToStep",
   "schema:position": 2,
   "schema:text": "Before writing a forecast, decide your own number or range first, then pick the one word on the scale whose range contains it."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/3",
   "@type": "schema:HowToStep",
   "schema:position": 3,
   "schema:text": "Put the numeric range in brackets right after the word in the text itself (\"likely (55-80%)\"), not in a footnote, appendix or hover text."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/4",
   "@type": "schema:HowToStep",
   "schema:position": 4,
   "schema:text": "Keep likelihood (how probable the event is) separate from confidence (how solid your evidence is), and say each in its own sentence."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/5",
   "@type": "schema:HowToStep",
   "schema:position": 5,
   "schema:text": "Reserve \"possible\", \"could\" and \"may\" for cases where you genuinely cannot estimate the odds, and say so rather than using them as softeners."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/words-of-estimative-probability/howto/6",
   "@type": "schema:HowToStep",
   "schema:position": 6,
   "schema:text": "Use the same words with the same meanings in every report, and add a short key whenever a new reader joins the distribution."
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/zoom-fatigue/check/1",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:zoom-fatigue"
   },
   "rdfs:label": "Does this conversation need video at all, or would a phone call, a shared document or a written update do the job?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/zoom-fatigue/check/2",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:zoom-fatigue"
   },
   "rdfs:label": "Have I booked video meetings back to back with no break to stand up, move or look away from the screen?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/zoom-fatigue/check/3",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:zoom-fatigue"
   },
   "rdfs:label": "Am I watching my own tile more than the people I am talking to, and could I hide self-view?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/zoom-fatigue/check/4",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:zoom-fatigue"
   },
   "rdfs:label": "Did I make it clear that cameras are optional for this meeting, especially for newer team members?"
  },
  {
   "@id": "https://github.com/john1hsu/communication-graph/id/zoom-fatigue/check/5",
   "@type": "cmo:SelfCheckQuestion",
   "cmo:questionFor": {
    "@id": "cm:zoom-fatigue"
   },
   "rdfs:label": "Did people have a moment to connect as a group, or did we go straight into a wall of faces and slides?"
  }
 ]
}
